---
import "/src/styles/global.css";

import { ClientRouter } from "astro:transitions";
import Header from "../components/common/Header.astro";

interface Props {
  title: string;
  description: string;
  keywords: string;
  author: string;
  applicationName?: string;
  url: string;
  image: string;
  imageAlt?: string;
  robots?: string;
  canonical?: string;
  lang?: string;
  showHeader?: boolean;
  /** Carga coi-serviceworker para cross-origin isolation (solo /terminal: SharedArrayBuffer) */
  crossOriginIsolated?: boolean;
  /** "cat" (acento del sitio) | "blue" (azul original, mini-apps/animaciones) | "auto" (por ruta) */
  accent?: "cat" | "blue" | "auto";
}

/* Páginas con diseño de app propia: conservan el azul Tailwind original.
   El acento naranja gato es identidad del sitio (header, bentos, posts...),
   no de estas herramientas. */
const APP_BLUE_PATHS = [
  "/animations",
  "/dominos",
  "/can-i-use-gpu",
  "/code-to-img",
  "/code-to-video",
  "/comprimir-pdf",
  "/cover-creator",
  "/intruso",
  "/mapa-personalizado",
  "/marca-agua-pdf",
  "/recortar-pdf",
  "/remover-fondo",
  "/rotador-imagenes",
  "/terminal",
];

const {
  title,
  description,
  keywords,
  author,
  url,
  applicationName = "Portafolio de Christopher Villamarín",
  image = "/assets/images/logo_v3.png",
  imageAlt = "Portafolio de Christopher Villamarín",
  robots = "index, follow",
  canonical,
  lang = "es",
  showHeader = true,
  crossOriginIsolated = false,
  accent = "auto",
} = Astro.props;

const pathname = Astro.url.pathname;
const appBlueByPath = APP_BLUE_PATHS.some(
  (p) => pathname === p || pathname === `${p}/` || pathname.startsWith(`${p}/`),
);
const useBlueAccent = accent === "blue" || (accent === "auto" && appBlueByPath);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f2937" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/assets/images/icon-192x192.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="creator" content={author} />
    <meta name="application-name" content={applicationName} />
    <meta name="robots" content={robots} />
    <meta name="algolia-site-verification" content="839FA93308FEFD9D" />
    <meta
      name="google-site-verification"
      content="00zwLtdgjhmCPvhPBvazB4JmCArQ-0tFJMxNuhrCuIE"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:site" content="@xeland314" />
    <meta name="twitter:creator" content="@xeland314" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="preload" href="/fonts/Inter-VariableFont-latin.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />

    {
      crossOriginIsolated && (
        <script is:inline src="/coi-serviceworker.js" />
      )
    }

    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(reg => console.log('PWA ServiceWorker registrado exitosamente.', reg.scope))
            .catch(err => console.log('Error al registrar PWA ServiceWorker:', err));
        });
      } else if (import.meta.env.DEV && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.getRegistrations().then((regs) => {
            for (const reg of regs) {
              if (reg.active && reg.active.scriptURL.includes('/sw.js')) {
                reg.unregister();
              }
            }
          });
        });
      }
    </script>

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <ClientRouter />
  </head>
  <body class="font-inter bg-white text-black dark:bg-gray-800 dark:text-white">
    <div class="mx-auto pt-0">
      {showHeader && <Header />}
      <div class={useBlueAccent ? "theme-blue" : undefined}>
        <slot />
      </div>
      <script is:inline src="/scripts/smoothScrollWithOffset.js"></script>
    </div>
  </body>
</html>
