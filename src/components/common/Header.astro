---
import LanguageSwitcher from "./LanguageSwitcher";
import ThemedToggleIconButton from "../themes/ThemedToggleIconButton";

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "es";
const homeLink = lang === "en" ? "/en" : "/";
const sectionBase = lang === "en" ? "/en" : "/es";

const t =
  lang === "en"
    ? {
        home: "Home",
        projects: "Projects",
        posts: "Posts",
        blogs: "Blogs",
        certificates: "Certificates",
        services: "Services",
        animations: "Animations",
        miniApps: "Mini Apps",
        videos: "Videos",
        contact: "Contact",
        menu: "Open menu",
      }
    : {
        home: "Inicio",
        projects: "Proyectos",
        posts: "Posts",
        blogs: "Blogs",
        certificates: "Certificados",
        services: "Servicios",
        animations: "Animaciones",
        miniApps: "Mini Apps",
        videos: "Videos",
        contact: "Contacto",
        menu: "Abrir menú",
      };

interface NavLink {
  href: string;
  label: string;
  prefix?: boolean;
}

const links: NavLink[] = [
  { href: homeLink, label: t.home },
  { href: `${sectionBase}/projects`, label: t.projects, prefix: true },
  { href: `${sectionBase}/posts`, label: t.posts, prefix: true },
  { href: `${sectionBase}/blogs`, label: t.blogs, prefix: true },
  { href: `${sectionBase}/certificates`, label: t.certificates, prefix: true },
  ...(lang === "es"
    ? [{ href: `${sectionBase}/services`, label: t.services, prefix: true }]
    : []),
  { href: "/animations", label: t.animations, prefix: true },
  { href: "/mini-apps", label: t.miniApps, prefix: true },
  { href: "/videos", label: t.videos, prefix: true },
  { href: `${homeLink}#contact`, label: t.contact },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const current = normalize(currentPath);

const isActive = (link: NavLink) => {
  const target = normalize(link.href.replace(/#.*$/, ""));
  if (target === homeLink.replace(/\/+$/, "") && link.href.includes("#")) {
    return false;
  }
  if (target === "" || target === homeLink.replace(/\/+$/, "")) {
    return current === target;
  }
  return link.prefix
    ? current === target || current.startsWith(`${target}/`)
    : current === target;
};
---

<header
  id="main-header"
  class="my-header sticky top-0 z-50 h-auto w-full bg-gray-900 text-white backdrop-blur-sm supports-backdrop-filter:bg-background/60"
  data-menu-open="false"
>
  <nav class="flex justify-between items-center relative p-3">
    <a
      href={homeLink}
      class="flex items-center text-lg font-bold hover:text-blue-500 transition-colors"
    >
      <img
        src="/assets/images/logo_v3.png"
        alt="Logo xeland314"
        class="h-8 w-8 mr-2"
        width="20"
        height="20"
        title="¿Por qué hay un gato aquí?"
        loading="eager"
      />
      xeland314
    </a>

    <div class="flex items-center gap-1">
      <LanguageSwitcher client:idle />

      <ThemedToggleIconButton client:idle />

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={t.menu}
        class="p-2 rounded-lg text-white focus:outline-none transition duration-300 ease-in-out hover:text-blue-500 hover:bg-gray-800"
      >
        <svg
          id="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div
      id="site-menu"
      class="absolute top-full inset-x-0 bg-gray-900 border-b border-gray-800 shadow-xl overflow-hidden transition-all duration-200 ease-out"
    >
      <ul
        class="grid grid-cols-2 sm:grid-cols-3 gap-1 p-4 max-w-3xl mx-auto list-none"
        role="list"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link) ? "page" : undefined}
                class={`block px-4 py-3 rounded-xl text-sm font-bold transition-colors ${
                  isActive(link)
                    ? "text-blue-400 bg-gray-800/60"
                    : "text-gray-200 hover:bg-gray-800 hover:text-blue-400"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  #site-menu {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem);
    pointer-events: none;
  }

  header[data-menu-open="true"] #site-menu {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  const header = document.getElementById("main-header");
  const toggleButton = document.getElementById("menu-toggle");
  const menuPanel = document.getElementById("site-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  const isOpen = () => header?.dataset.menuOpen === "true";

  const setOpen = (open: boolean) => {
    if (!header || !toggleButton || !iconOpen || !iconClose) return;
    header.dataset.menuOpen = String(open);
    toggleButton.setAttribute("aria-expanded", String(open));
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
  };

  toggleButton?.addEventListener("click", (event) => {
    event.stopPropagation();
    setOpen(!isOpen());
  });

  document.addEventListener("click", (event) => {
    if (!isOpen()) return;
    const target = event.target as Node;
    if (menuPanel?.contains(target) || toggleButton?.contains(target)) return;
    setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) setOpen(false);
  });

  menuPanel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
