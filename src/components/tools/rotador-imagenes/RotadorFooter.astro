---
// FooterRotador.astro
---

<div
  class="w-full max-w-4xl mx-auto mt-6 mb-12 px-4 transition-colors duration-300"
>
  <div
    class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-3xl p-6 sm:px-8 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6 transition-colors duration-300"
  >
    <!-- Información / Copyright -->
    <div class="text-center sm:text-left">
      <h3
        class="text-gray-900 dark:text-white font-bold text-sm tracking-widest uppercase mb-1"
      >
        Rotador de Imágenes
      </h3>
      <p class="text-gray-500 dark:text-gray-400 text-xs font-mono">
        Desarrollado por Christopher Villamarín (@xeland314)
      </p>
    </div>

    <!-- Botones de Acción -->
    <div class="flex flex-col sm:flex-row w-full sm:w-auto gap-3">
      <!-- Botón de instalación (Oculto por defecto hasta que el navegador confirme que es instalable) -->
      <button
        id="btn-install-pwa"
        class="hidden w-full sm:w-auto items-center justify-center gap-2 px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold transition-all duration-200 hover:shadow-lg hover:shadow-blue-600/30 hover:-translate-y-0.5 active:scale-95"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Instalar App
      </button>

      <!-- Botón Volver al Portafolio -->
      <a
        href="/"
        class="flex w-full sm:w-auto items-center justify-center gap-2 px-5 py-3 rounded-xl border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-sm font-semibold text-gray-700 dark:text-gray-300 hover:border-gray-400 dark:hover:border-gray-500 hover:bg-white dark:hover:bg-gray-700 transition-all duration-200 active:scale-95 shadow-sm"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Volver al portafolio
      </a>
    </div>
  </div>
</div>

<script>
  let deferredPrompt: any;
  const installBtn = document.getElementById("btn-install-pwa");

  window.addEventListener("beforeinstallprompt", (e) => {
    // Previene que aparezca el mini-infobar automático en móviles
    e.preventDefault();
    // Guarda el evento para que pueda ser disparado después.
    deferredPrompt = e;

    // Muestra nuestro botón personalizado
    if (installBtn) {
      installBtn.classList.remove("hidden");
      installBtn.classList.add("flex");
    }
  });

  if (installBtn) {
    installBtn.addEventListener("click", async () => {
      if (!deferredPrompt) return;

      // Ocultamos el botón temporalmente
      installBtn.classList.remove("flex");
      installBtn.classList.add("hidden");

      // Mostramos el prompt nativo de instalación de Android/Chrome
      deferredPrompt.prompt();

      // Esperamos a que el usuario responda
      const { outcome } = await deferredPrompt.userChoice;

      if (outcome === "accepted") {
        console.log("El usuario aceptó instalar la PWA");
      } else {
        console.log("El usuario rechazó la instalación");
        // Si rechaza, volvemos a mostrar nuestro botón por si cambia de opinión
        installBtn.classList.remove("hidden");
        installBtn.classList.add("flex");
      }

      // Descartamos el evento porque ya no se puede usar de nuevo
      deferredPrompt = null;
    });
  }

  // Escuchamos si la app se instaló exitosamente (incluso si lo hizo desde el menú del navegador)
  window.addEventListener("appinstalled", () => {
    if (installBtn) {
      installBtn.classList.remove("flex");
      installBtn.classList.add("hidden");
    }
    deferredPrompt = null;
    console.log("PWA instalada con éxito");
  });
</script>
