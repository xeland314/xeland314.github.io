          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-gray-500 dark:text-gray-500 hover:text-pink-400 hover:bg-gray-200/60 dark:hover:bg-white/10 transition-all hover:scale-110"
          aria-label="Instagram"
