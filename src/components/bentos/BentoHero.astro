            ></path></svg
          >
        </a>
        <a
          href="https://threads.com/@xeland314"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-gray-500 dark:text-gray-500 hover:text-blue-500 hover:bg-gray-200/60 dark:hover:bg-white/10 transition-all hover:scale-110"
          aria-label="Threads"
          title="Threads"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"></path></svg
          >
        </a>

        <div class="w-px h-4 dark:bg-white/10 bg-gray-200 mx-1"></div>

        {/* Copy email */}
        <div class="relative">
          <button
            id="hero-copy-email"
            type="button"
            class="text-gray-500 dark:text-gray-500 hover:text-blue-400 transition-colors"
            aria-label={T.copy_label}
            title={T.copy_label}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                d="m22 7-8.97 5.7 a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
            >
          </button>
          <span
            id="hero-copy-success"
            class="absolute -top-9 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-blue-600 text-white text-[10px] font-bold rounded-lg opacity-0 transition-opacity pointer-events-none whitespace-nowrap"
          >
            {T.copied}
          </span>
        </div>

        <div class="w-px h-4 dark:bg-white/10 bg-gray-200 mx-1"></div>

        {/* Lang switcher + theme */}
        <a
          href={lang === "es" ? "/en/" : "/"}
          class="text-sm font-mono font-bold text-gray-500 dark:text-gray-500 hover:text-blue-600 dark:hover:text-white transition-colors uppercase"
        >
          {lang === "es" ? "EN" : "ES"}
        </a>
        <div class="bg-blue-600 dark:bg-gray-950 p-0 rounded-lg">
          <ThemeToggleButton client:idle />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Definición de Variables CSS en la raíz (Asegura que el color siempre se aplique) ── */
  :global(:root) {
    --grid-line: rgba(
      15,
      23,
      42,
      0.08
    ); /* Gris azulado visible para modo claro */
  }

  :global(.dark),
  :global([data-theme="dark"]) {
    --grid-line: rgba(
      255,
      255,
      255,
      0.05
    ); /* Blanco muy tenue para modo oscuro */
  }

  /* ── Grid texture ── */
  .hero-grid {
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    /* Difuminado hacia los bordes para un look premium en ambos modos */
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(
      ellipse at center,
      black 30%,
      transparent 80%
    );
  }

  /* ── Fade-in animation ── */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-in {
    opacity: 0;
    animation: hero-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-cat {
    filter: drop-shadow(
      0 0 15px rgba(249, 115, 22, 0.2)
    ); /* Un naranja tenue */
    animation: cat-float 4.5s ease-in-out infinite;
  }

  @keyframes cat-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  /* ── Typewriter caret blink fallback ── */
  #hero-rotator::after {
    color: rgba(59, 130, 246, 0.6);
  }

  .hero-avatar-card:hover .hero-cat {
    animation-play-state: paused;
  }

  /* ── Light mode bg override ── */
  :global(.light) #hero,
  :global([data-theme="light"]) #hero {
    background-color: #ffffff;
  }

  :global(.dark) #hero,
  :global([data-theme="dark"]) #hero {
    background-color: #030712;
  }
</style>

<script>
  const setupHeroCopy = () => {
    const btn = document.getElementById("hero-copy-email");
    const msg = document.getElementById("hero-copy-success");
    if (!btn) return;

    const u = "christopher.villamarin";
    const d = "protonmail.com";

    btn.addEventListener("click", () => {
      navigator.clipboard.writeText(`${u}@${d}`);
      msg?.classList.remove("opacity-0");
      setTimeout(() => msg?.classList.add("opacity-0"), 2000);
    });
  };

  setupHeroCopy();
  document.addEventListener("astro:after-swap", setupHeroCopy);

  const TYPE_MS = 55;
  const DELETE_MS = 28;
  const HOLD_MS = 2200;

  const setupRotator = () => {
    const el = document.getElementById("hero-rotator");
    if (!el || (el as HTMLElement).dataset.rotatorBound === "1") return;
    (el as HTMLElement).dataset.rotatorBound = "1";

    let phrases: string[] = [];
    try {
      phrases = JSON.parse((el as HTMLElement).dataset.phrases ?? "[]");
    } catch {
      phrases = [];
    }
    if (phrases.length === 0) return;

    let phraseIndex = 0;
    let charIndex = phrases[0].length;
    let deleting = false;

    const tick = () => {
      const current = phrases[phraseIndex];
      charIndex += deleting ? -1 : 1;
      el!.textContent = current.slice(0, charIndex);

      let delay = deleting ? DELETE_MS : TYPE_MS;

      if (!deleting && charIndex >= current.length) {
        delay = HOLD_MS;
        deleting = true;
      } else if (deleting && charIndex <= 0) {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        delay = 350;
      }

      window.setTimeout(tick, delay);
    };

    window.setTimeout(tick, HOLD_MS);
  };

  setupRotator();
  document.addEventListener("astro:after-swap", setupRotator);
</script>
