---
import "./umask.css";

const ROWS = [
  { prefix: "a", y: 40 },
  { prefix: "b", y: 78 },
  { prefix: "c", y: 116 },
  { prefix: "d", y: 176 },
];
const cellX = (i: number) => 128 + i * 22 + Math.floor(i / 3) * 8;
---

<div class="anim-um-card">
  <svg class="anim-um-svg" viewBox="0 0 360 250" fill="none">
    <text x="8" y="14" class="um-title">UMASK: default &amp; ~máscara (rwx rwx rwx)</text>

    <text x="8" y="52" class="um-rowlabel">defecto archivo</text>
    <text id="octA" x="330" y="52" text-anchor="end" class="um-octal">666</text>
    <text x="8" y="90" class="um-rowlabel">máscara</text>
    <text id="octB" x="330" y="90" text-anchor="end" class="um-octal">022</text>
    <text x="8" y="128" class="um-rowlabel">resultado</text>
    <text id="octC" x="330" y="128" text-anchor="end" class="um-octal">644</text>

    <text x="118" y="160" class="um-op">&amp; ~022 aplicado bit a bit:</text>

    <text x="8" y="188" class="um-rowlabel">directorio</text>
    <text id="octD" x="330" y="188" text-anchor="end" class="um-octal">755</text>

    <text id="noteText" x="8" y="232" class="um-note"
      >r=4 · w=2 · x=1 — la máscara QUITA bits, nunca añade.</text
    >

    {ROWS.map((row) => (
      <g>
        {[...Array(9)].map((_, i) => (
          <rect
            id={`${row.prefix}${i}`}
            x={cellX(i)}
            y={row.y}
            width="18"
            height="15"
            rx="3"
            class="um-cell off"
          />
        ))}
      </g>
    ))}
  </svg>
</div>
