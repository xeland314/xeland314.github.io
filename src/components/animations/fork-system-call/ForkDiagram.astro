---
import "./fork.css";
---

<div class="anim-fk-card">
  <svg class="anim-fk-svg" viewBox="0 0 360 250" fill="none">
    <defs>
      <marker
        id="fkArrowHead"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="5.5"
        markerHeight="5.5"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="fk-dup-head"></path>
      </marker>
    </defs>

    <text x="8" y="14" class="fk-title">PROCESOS: fork() duplica al llamador</text>

    <rect x="126" y="24" width="108" height="22" rx="6" class="fk-box"></rect>
    <text x="180" y="39" text-anchor="middle" class="fk-node-label">bash · pid=1000</text>

    <path d="M 180 46 L 180 62" class="fk-edge trunk"></path>

    <g id="groupSingle" class="fk-group">
      <rect id="nodeSingle" x="104" y="62" width="152" height="26" rx="7" class="fk-proc"></rect>
      <text x="180" y="79" text-anchor="middle" class="fk-node-label">fork_demo · pid=1000</text>
    </g>

    <path
      id="dupArrow"
      d="M 256 88 C 306 98, 306 116, 268 128"
      class="fk-dup"
      marker-end="url(#fkArrowHead)"
    ></path>

    <path id="edgeParent" d="M 180 88 C 180 106, 98 106, 98 122" class="fk-edge a-padre" opacity="0"></path>
    <path id="edgeChild" d="M 180 88 C 180 106, 262 106, 262 122" class="fk-edge a-hijo" opacity="0"></path>

    <g id="groupParent" class="fk-group" opacity="0">
      <rect id="nodeParent" x="26" y="122" width="144" height="26" rx="7" class="fk-proc padre"></rect>
      <text x="98" y="139" text-anchor="middle" class="fk-node-label">padre · pid=1000</text>
    </g>

    <g id="groupChild" class="fk-group" opacity="0">
      <rect id="nodeChild" x="190" y="122" width="144" height="26" rx="7" class="fk-proc hijo"></rect>
      <text x="262" y="139" text-anchor="middle" class="fk-node-label">hijo · pid=4321</text>
    </g>

    <g id="chipParent" class="fk-group" opacity="0">
      <rect x="40" y="156" width="116" height="17" rx="8.5" class="fk-chip false"></rect>
      <text x="98" y="167.5" text-anchor="middle" class="fk-chip-text falso">pid == 0 → falso</text>
    </g>

    <g id="chipChild" class="fk-group" opacity="0">
      <rect x="204" y="156" width="116" height="17" rx="8.5" class="fk-chip true"></rect>
      <text x="262" y="167.5" text-anchor="middle" class="fk-chip-text verdadero">pid == 0 → verdadero</text>
    </g>

    <text id="retParent" x="98" y="188" text-anchor="middle" class="fk-ret" opacity="0">return 0</text>
    <text id="retChild" x="262" y="188" text-anchor="middle" class="fk-ret" opacity="0">return 0</text>

    <text id="stateText" x="8" y="212" class="fk-state">estado: bash ejecuta ./fork_demo</text>

    <text id="noteText" x="8" y="234" class="fk-note"
      >fork() retorna dos veces: 0 en el hijo · pid del hijo en el padre.</text
    >
  </svg>
</div>
