---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TOOLS } from "../../components/bentos/tools-data";

const siteTitle = "Mini Apps | Christopher Villamarín";
const siteDescription =
  "Colección de mini apps y herramientas web: recortar PDF, rotador de imágenes, visualizador y solver de dominós, code to image, cover creator, code to video y chat analyzer.";
const siteKeywords =
  "mini apps, herramientas web, recortar pdf, rotador de imágenes, dominós, domino solver, code to image, cover creator, code to video, chat analyzer";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/mini-apps/";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <main class="min-h-screen bg-[#060a0f] text-gray-200 py-12 px-4 sm:px-8">
    <div class="max-w-6xl mx-auto">
      <header class="mb-14">
        <a
          href="/"
          class="text-blue-400 hover:underline mb-6 inline-flex items-center gap-2 font-bold transition-all hover:-translate-x-1"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-left"
            ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg
          >
          Volver al inicio
        </a>
        <h1
          class="text-4xl md:text-6xl font-black text-white mb-6 tracking-tighter"
        >
          Mini{" "}
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-400 to-pink-400"
            >Apps</span
          >
        </h1>
        <p class="text-xl text-gray-400 max-w-3xl leading-relaxed">
          Herramientas pequeñas que hacen una sola cosa bien:{" "}
          <span class="text-emerald-400 font-bold">recortar PDFs</span>,{" "}
          <span class="text-fuchsia-400 font-bold">rotar imágenes</span>,{" "}
          <span class="text-red-400 font-bold">resolver dominós</span> o generar
          imágenes y videos a partir de código. Sin cuentas, sin instalar nada.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          TOOLS.map((tool, idx) => (
            <a
              href={tool.href}
              aria-label={`${tool.title.es} — ${tool.description.es}`}
              target={tool.external ? "_blank" : undefined}
              rel={tool.external ? "noopener noreferrer" : undefined}
              class="group relative flex flex-col gap-4 p-6 rounded-3xl border border-white/10 bg-white/[0.03] hover:border-white/25 hover:bg-white/[0.06] transition-all duration-300 hover:-translate-y-1 overflow-hidden"
            >
              <span
                class="absolute top-4 right-5 font-mono text-xs text-white/20 font-bold"
                aria-hidden="true"
              >
                {String(idx + 1).padStart(2, "0")}
              </span>

              {tool.external && (
                <span
                  class="absolute top-4 left-5 text-white/30 group-hover:text-fuchsia-300 transition-colors"
                  aria-label="Enlace externo"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path
                    ><path
                      d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                    ></path></svg
                  >
                </span>
              )}

              <div
                aria-hidden="true"
                class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${tool.gradient} flex items-center justify-center shadow-lg`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <Fragment set:html={tool.icon} />
                </svg>
              </div>

              <div class="flex-1">
                <h2
                  class="text-lg font-black text-white group-hover:text-fuchsia-300 transition-colors tracking-tight"
                >
                  {tool.title.es}
                </h2>
                <p class="mt-2 text-sm text-gray-400 leading-relaxed">
                  {tool.description.es}
                </p>
              </div>

              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold text-white/40 uppercase tracking-wider bg-white/5 border border-white/10 px-2 py-0.5 rounded">
                  {tool.badge.es}
                </span>
                <span
                  class="text-xs font-bold text-fuchsia-300 opacity-0 group-hover:opacity-100 transition-opacity"
                >
                  Abrir app →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
