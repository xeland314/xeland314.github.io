---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteTitle = "Dominos — Visualizador de fichas de dominó";
const siteDescription = "Visualiza y construye cadenas de dominó con SVG. Genera fichas estándar con puntos, prueba cadenas y exporta.";
const siteKeywords = "dominó, fichas, dominó visualización, cadena de dominó, SVG dominó";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/dominos";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <div 
    class="min-h-screen py-10 px-5 text-[#33393e] font-mono bg-[#eaf1f3]"
    style="background-image: linear-gradient(#d3e0e4 1px, transparent 1px), linear-gradient(90deg, #d3e0e4 1px, transparent 1px); background-size: 100% 32px, 32px 100%;"
  >
    <div class="max-w-[720px] mx-auto bg-white/55 border border-[#d3e0e4] rounded p-8 sm:p-9 shadow-[0_1px_0_rgba(0,0,0,0.03)]">
      <p class="text-[11px] tracking-[0.16em] text-[#8b98a3] uppercase mb-1.5">Juegos de mesa · dominó</p>
      <h1 class="font-serif font-bold text-[28px] mb-1.5 text-[#33393e]">Dominós</h1>
      <p class="text-[#6b7680] font-serif text-[14.5px] leading-relaxed mb-[26px] max-w-[56ch]">
        Genera fichas de dominó con SVG puro. Selecciona valores, arma cadenas y visualiza cómo encajan las piezas.
      </p>

      <div class="mb-[22px]">
        <label class="block text-xs tracking-[0.06em] uppercase text-[#6b7680] mb-2">
          Crear ficha
        </label>
        <div class="flex gap-2 items-end">
          <div class="flex-1">
            <label for="top-pip" class="block text-[11px] text-[#8b98a3] mb-1">Mitad superior</label>
            <select
              id="top-pip"
              class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
            >
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3" selected>3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
            </select>
          </div>
          <div class="flex-1">
            <label for="bottom-pip" class="block text-[11px] text-[#8b98a3] mb-1">Mitad inferior</label>
            <select
              id="bottom-pip"
              class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
            >
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5" selected>5</option>
              <option value="6">6</option>
            </select>
          </div>
          <div class="flex-1">
            <label for="tile-size" class="block text-[11px] text-[#8b98a3] mb-1">Tamaño</label>
            <select
              id="tile-size"
              class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
            >
              <option value="small">Pequeña</option>
              <option value="medium" selected>Mediana</option>
              <option value="large">Grande</option>
            </select>
          </div>
          <button
            id="btn-add-tile"
            class="font-serif font-bold text-sm bg-[#33393e] text-white border-0 py-[11px] px-[18px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#1f2428] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          >
            Crear
          </button>
        </div>
      </div>

      <div class="mb-[22px]">
        <label class="block text-xs tracking-[0.06em] uppercase text-[#6b7680] mb-2">
          Fichas disponibles
        </label>
        <div id="available-tiles" class="flex flex-wrap justify-center gap-2 mb-3 min-h-[40px] bg-white border border-[#d3e0e4] rounded-[3px] p-2.5"></div>
      </div>

      <div class="flex gap-2 mb-[22px]">
        <button
          id="btn-generate-set"
          class="font-serif font-bold text-sm bg-[#33393e] text-white border-0 py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#1f2428] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
        >
          Generar juego completo
        </button>
        <button
          id="btn-shuffle"
          class="font-serif font-bold text-sm bg-white text-[#6b7680] border border-[#d3e0e4] py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#f5f7f8] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
        >
          Mezclar
        </button>
      </div>

      <div class="mb-[22px]">
        <label class="block text-xs tracking-[0.06em] uppercase text-[#6b7680] mb-2">
          Cadena
        </label>
        <div id="chain-tiles" class="flex flex-wrap justify-center gap-1 min-h-[80px] bg-[#f8fafb] border border-[#e8edef] rounded-[3px] p-3 items-center mb-3"></div>
        <div id="chain-info" class="text-[11px] text-[#8b98a3] font-mono mb-2"></div>
        <div class="flex gap-2">
          <button
            id="btn-clear-chain"
            class="font-serif font-bold text-sm bg-white text-[#6b7680] border border-[#d3e0e4] py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#f5f7f8] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          >
            Vaciar cadena
          </button>
        </div>
      </div>

      <div class="border-t border-dashed border-[#d3e0e4] pt-5 mt-4 mb-[22px]">
        <p class="text-[11px] tracking-[0.16em] text-[#8b98a3] uppercase mb-1.5">Constructor</p>
        <h2 class="font-serif font-bold text-[20px] mb-1.5 text-[#33393e]">Secuencia</h2>
        <p class="text-[#6b7680] font-serif text-[13px] leading-relaxed mb-[18px] max-w-[56ch]">
          Construye una secuencia de fichas manualmente o desde un patrón. El layout determina cómo se dibujan en el lienzo.
        </p>

        <div class="flex gap-2 items-end mb-3">
          <div>
            <label for="seq-layout" class="block text-[11px] text-[#8b98a3] mb-1">Layout</label>
            <select id="seq-layout" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="grid">Cuadrícula</option>
              <option value="row">Fila</option>
              <option value="column">Columna</option>
              <option value="free">Libre</option>
            </select>
          </div>
          <div id="seq-columns-wrap">
            <label for="seq-columns" class="block text-[11px] text-[#8b98a3] mb-1">Columnas</label>
            <input type="number" id="seq-columns" value="3" min="1" max="7" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
          <div>
            <label for="seq-gap" class="block text-[11px] text-[#8b98a3] mb-1">Gap</label>
            <input type="number" id="seq-gap" value="12" min="0" max="60" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
          <button
            id="btn-clear-sequence"
            class="font-serif font-bold text-sm bg-white text-[#6b7680] border border-[#d3e0e4] py-[11px] px-[18px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#f5f7f8] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          >
            Vaciar
          </button>
        </div>

        <div class="flex gap-2 items-end mb-3">
          <div class="flex-1">
            <label for="seq-top" class="block text-[11px] text-[#8b98a3] mb-1">Top</label>
            <select id="seq-top" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3" selected>3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
            </select>
          </div>
          <div class="flex-1">
            <label for="seq-bottom" class="block text-[11px] text-[#8b98a3] mb-1">Bottom</label>
            <select id="seq-bottom" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5" selected>5</option>
              <option value="6">6</option>
            </select>
          </div>
          <div class="flex-1">
            <label for="seq-size" class="block text-[11px] text-[#8b98a3] mb-1">Tamaño</label>
            <select id="seq-size" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="small">Pequeña</option>
              <option value="medium" selected>Mediana</option>
              <option value="large">Grande</option>
            </select>
          </div>
          <div class="flex-1">
            <label for="seq-orientation" class="block text-[11px] text-[#8b98a3] mb-1">Orientación</label>
            <select id="seq-orientation" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="vertical">Vertical</option>
              <option value="horizontal">Horizontal</option>
            </select>
          </div>
          <button
            id="btn-seq-add"
            class="font-serif font-bold text-sm bg-[#33393e] text-white border-0 py-[11px] px-[18px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#1f2428] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          >
            Agregar
          </button>
        </div>

        <div id="seq-operations" class="mb-3"></div>
        <div id="seq-preview" class="bg-[#f8fafb] border border-[#e8edef] rounded-[3px] p-3"></div>
      </div>

      <div class="border-t border-dashed border-[#d3e0e4] pt-5 mt-4 mb-[22px]">
        <p class="text-[11px] tracking-[0.16em] text-[#8b98a3] uppercase mb-1.5">Exportación</p>
        <h2 class="font-serif font-bold text-[20px] mb-1.5 text-[#33393e]">Exportar imágenes</h2>
        <p class="text-[#6b7680] font-serif text-[13px] leading-relaxed mb-[18px] max-w-[56ch]">
          Exporta la secuencia como imagen PNG. Exporta todo, selecciona fichas específicas o divide en segmentos para generar un ZIP.
        </p>

        <div class="flex gap-2 items-end mb-3">
          <div>
            <label for="export-mode" class="block text-[11px] text-[#8b98a3] mb-1">Modo</label>
            <select id="export-mode" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="completa">Completa</option>
              <option value="seleccion">Selección</option>
              <option value="segmentado">Segmentado</option>
            </select>
          </div>
          <div id="export-segment-wrap" class="hidden">
            <label for="export-segment-size" class="block text-[11px] text-[#8b98a3] mb-1">Tamaño segmento</label>
            <input type="number" id="export-segment-size" value="4" min="1" max="28" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
          <button
            id="btn-export"
            class="font-serif font-bold text-sm bg-[#33393e] text-white border-0 py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#1f2428] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          >
            Exportar
          </button>
        </div>

        <div id="export-selection" class="hidden mb-3"></div>
      </div>

      <div class="border-t border-dashed border-[#d3e0e4] pt-5 mt-4">
        <p class="text-[11px] tracking-[0.16em] text-[#8b98a3] uppercase mb-1.5">Patrones</p>
        <h2 class="font-serif font-bold text-[20px] mb-1.5 text-[#33393e]">Generador de patrones</h2>
        <p class="text-[#6b7680] font-serif text-[13px] leading-relaxed mb-[18px] max-w-[56ch]">
          Genera secuencias de fichas según una regla matemática. Oculta fichas para crear problemas de examen.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-[18px]">
          <div>
            <label for="pattern-rule" class="block text-[11px] text-[#8b98a3] mb-1">Regla</label>
            <select id="pattern-rule" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="fraccion">Fracción (delta independiente)</option>
              <option value="suma-constante">Suma constante</option>
              <option value="espejo">Espejo</option>
              <option value="encadenado-clasico">Encadenado clásico</option>
            </select>
          </div>
          <div id="param-fraccion-top">
            <label for="pattern-top-delta" class="block text-[11px] text-[#8b98a3] mb-1">Top Δ</label>
            <input type="number" id="pattern-top-delta" value="2" min="-6" max="6" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
          <div id="param-fraccion-bottom">
            <label for="pattern-bottom-delta" class="block text-[11px] text-[#8b98a3] mb-1">Bottom Δ</label>
            <input type="number" id="pattern-bottom-delta" value="3" min="-6" max="6" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
          <div id="param-constante" class="hidden">
            <label for="pattern-delta" class="block text-[11px] text-[#8b98a3] mb-1">Delta</label>
            <input type="number" id="pattern-delta" value="1" min="-6" max="6" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-[18px]">
          <div>
            <label for="pattern-start-top" class="block text-[11px] text-[#8b98a3] mb-1">Inicio top</label>
            <select id="pattern-start-top" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="0">0</option>
              <option value="1" selected>1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
            </select>
          </div>
          <div>
            <label for="pattern-start-bottom" class="block text-[11px] text-[#8b98a3] mb-1">Inicio bottom</label>
            <select id="pattern-start-bottom" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1">
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2" selected>2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
            </select>
          </div>
          <div>
            <label for="pattern-length" class="block text-[11px] text-[#8b98a3] mb-1">Longitud</label>
            <input type="number" id="pattern-length" value="9" min="1" max="28" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
          <div>
            <label for="pattern-hide" class="block text-[11px] text-[#8b98a3] mb-1">Ocultar (índices)</label>
            <input type="text" id="pattern-hide" placeholder="ej: 7,8" class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          </div>
        </div>

        <button
          id="btn-generate-pattern"
          class="font-serif font-bold text-sm bg-[#c4392b] text-white border-0 py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#a32f23] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
        >
          Generar patrón en secuencia
        </button>
      </div>

      <div id="resultado" class="mt-[30px]"></div>
    </div>
  </div>

  <div id="export-ghost" style="position:fixed;top:-9999px;left:-9999px;width:max-content;background:white;"></div>

  <script>
    import {
      createTile, buildFullSet, shuffleTiles, canPlaceRight, canPlaceLeft,
      placeRight, placeLeft, chainScore, isClosedChain, findMatchingTiles,
      scoreRemainingTiles, renderTileSVG, isDouble, tileSum,
      generatePattern, layoutTiles, getSubsets, renderLayoutHTML, tileLabel,
    } from "../components/tools/dominos/dominos";
    import type { PipCount, TileSize, TileOrientation, DominoTile, PatternRule, LayoutConfig, LayoutMode, PartialExportConfig } from "../components/tools/dominos/dominos";
    import { toBlob } from "html-to-image";
    import JSZip from "jszip";

    let availableTiles: DominoTile[] = [];
    let chain: DominoTile[] = [];
    let sequence: DominoTile[] = [];
    let currentLayout: LayoutConfig = { mode: "grid", gap: 12, columns: 3 };

    function renderAvailableTiles() {
      const container = document.getElementById("available-tiles");
      if (!container) return;
      if (availableTiles.length === 0) {
        container.innerHTML = '<p class="text-[11.5px] text-[#8b98a3] font-serif italic">No hay fichas. Crea una o genera el juego completo.</p>';
        return;
      }

      container.innerHTML = availableTiles.map((tile, i) => {
        const svg = renderTileSVG(tile);
        const label = tile.top === tile.bottom ? `Doble ${tile.top}` : `${tile.top}·${tile.bottom}`;
        return `
          <div class="flex flex-col items-center gap-1 bg-white border border-[#d3e0e4] rounded-[3px] p-1.5">
            ${svg}
            <span class="text-[9px] text-[#8b98a3] font-mono">${label}</span>
            <div class="flex gap-1">
              <button 
                data-index="${i}" 
                data-side="left"
                class="btn-chain-left font-serif text-[10px] text-[#6b7680] hover:text-[#33393e] cursor-pointer bg-transparent border border-[#d3e0e4] rounded px-1.5 py-0.5 hover:border-[#6b7680] transition-all"
                title="${label} ← izquierda"
              >↩</button>
              <button 
                data-index="${i}" 
                data-side="right"
                class="btn-chain-right font-serif text-[10px] text-[#c4392b] hover:text-[#a32f23] cursor-pointer bg-transparent border border-[#d3e0e4] rounded px-1.5 py-0.5 hover:border-[#c4392b] transition-all"
                title="${label} → derecha"
              >→</button>
              <button 
                data-index="${i}"
                class="btn-delete-tile font-serif text-[10px] text-[#c4392b] hover:text-[#a32f23] cursor-pointer bg-transparent border border-[#d3e0e4] rounded px-1.5 py-0.5 hover:border-[#c4392b] transition-all"
                title="Borrar ficha"
              >✖</button>
            </div>
          </div>
        `;
      }).join("");
    }

    document.getElementById("available-tiles")?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>(".btn-chain-right, .btn-chain-left, .btn-delete-tile");
      if (!btn) return;

      const idx = parseInt(btn.dataset.index!);
      if (isNaN(idx) || idx < 0 || idx >= availableTiles.length) return;

      if (btn.classList.contains("btn-delete-tile")) {
        availableTiles.splice(idx, 1);
        renderAll();
        return;
      }

      const tile = availableTiles[idx];

      if (chain.length === 0) {
        chain.push(tile);
        availableTiles.splice(idx, 1);
        renderAll();
        return;
      }

      if (btn.classList.contains("btn-chain-right") && canPlaceRight(chain, tile)) {
        chain = placeRight(chain, tile);
        availableTiles.splice(idx, 1);
        renderAll();
      } else if (btn.classList.contains("btn-chain-left") && canPlaceLeft(chain, tile)) {
        chain = placeLeft(chain, tile);
        availableTiles.splice(idx, 1);
        renderAll();
      }
    });

    function renderChain() {
      const container = document.getElementById("chain-tiles");
      const info = document.getElementById("chain-info");
      if (!container) return;

      if (chain.length === 0) {
        container.innerHTML = '<p class="text-[11.5px] text-[#8b98a3] font-serif italic">Haz clic en una ficha para agregarla a la cadena.</p>';
        if (info) info.textContent = "";
        return;
      }

      container.innerHTML = chain.map((tile, i) => {
        const svg = renderTileSVG(tile);
        const label = tile.top === tile.bottom ? `Doble ${tile.top}` : `${tile.top}·${tile.bottom}`;
        return `
          <div class="flex items-center">
            ${i > 0 ? '<span class="text-[#8b98a3] text-[10px] mx-0.5">—</span>' : ""}
            <div class="flex flex-col items-center">
              ${svg}
              <span class="text-[9px] text-[#8b98a3] font-mono mt-0.5">${label}</span>
            </div>
          </div>
        `;
      }).join("");

      if (info) {
        const score = chainScore(chain);
        const closed = isClosedChain(chain);
        const remaining = availableTiles.length;
        info.textContent = `Fichas: ${chain.length} · Puntas: ${score} · Cerrada: ${closed ? "Sí" : "No"} · En mano: ${remaining}`;
      }
    }

    function readLayout(): LayoutConfig {
      const mode = (document.getElementById("seq-layout") as HTMLSelectElement)?.value as LayoutMode || "grid";
      const columns = parseInt((document.getElementById("seq-columns") as HTMLInputElement)?.value) || 3;
      const gap = parseInt((document.getElementById("seq-gap") as HTMLInputElement)?.value) || 12;
      const colsWrap = document.getElementById("seq-columns-wrap");
      if (colsWrap) colsWrap.classList.toggle("hidden", mode === "free");
      return { mode, gap, columns };
    }

    function updatePreview() {
      const container = document.getElementById("seq-preview");
      if (!container) return;

      currentLayout = readLayout();

      if (sequence.length === 0) {
        container.innerHTML = '<p class="text-[11.5px] text-[#8b98a3] font-serif italic">Agrega fichas o genera un patrón para ver la vista previa.</p>';
        return;
      }

      const placed = layoutTiles(sequence, currentLayout);
      const isFree = currentLayout.mode === "free";

      const maxX = placed.reduce((m, p) => Math.max(m, p.x), 0) + 48;
      const maxY = placed.reduce((m, p) => Math.max(m, p.y), 0) + 96;

      const tilesHtml = placed.map((p, i) => {
        const svg = renderTileSVG(p.tile);
        const label = tileLabel(p.tile);
        const dragAttr = isFree ? `data-seq-drag="${i}" style="position:absolute;left:${p.x}px;top:${p.y}px;cursor:grab;"` : `style="position:absolute;left:${p.x}px;top:${p.y}px;"`;
        return `
          <div ${dragAttr} class="flex flex-col items-center">
            ${svg}
            <span class="text-[9px] text-[#8b98a3] font-mono mt-0.5">${label}</span>
          </div>
        `;
      }).join("");

      container.innerHTML = `
        <div class="relative bg-white border border-[#e8edef] rounded-[3px] p-4" style="width:${maxX}px;height:${maxY}px;">
          ${tilesHtml}
        </div>
      `;

      if (isFree) initDragHandlers();
    }

    function renderOperationsList() {
      const container = document.getElementById("seq-operations");
      if (!container) return;

      if (sequence.length === 0) {
        container.innerHTML = "";
        return;
      }

      const isFree = currentLayout.mode === "free";

      const rows = sequence.map((tile, i) => {
        const label = tileLabel(tile);
        const hiddenBtnClass = tile.isHidden
          ? "bg-[#c4392b] text-white border-[#c4392b]"
          : "text-[#6b7680] border-[#d3e0e4]";
        const hiddenBtnText = tile.isHidden ? "Visible" : "Oculta";

        const freeInputs = isFree ? `
          <input type="number" data-seq-idx="${i}" data-seq-field="x" value="${tile.x ?? 0}" class="seq-free-input w-16 bg-white border border-[#d3e0e4] rounded-[3px] py-1 px-2 font-mono text-[11px] text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
          <input type="number" data-seq-idx="${i}" data-seq-field="y" value="${tile.y ?? 0}" class="seq-free-input w-16 bg-white border border-[#d3e0e4] rounded-[3px] py-1 px-2 font-mono text-[11px] text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1" />
        ` : "";

        return `
          <div class="flex items-center gap-2 py-1.5 px-2 border-b border-[#e8edef] text-[12px]">
            <span class="text-[#8b98a3] font-mono w-5 text-right shrink-0">${i + 1}</span>
            <span class="font-mono text-[#33393e] shrink-0">${label}</span>
            <span class="text-[#8b98a3] font-mono text-[10px] shrink-0">${tile.orientation === "horizontal" ? "H" : "V"} · ${tile.size}</span>
            <div class="flex items-center gap-1 ml-auto shrink-0">
              ${freeInputs}
              <button data-seq-toggle="${i}" class="btn-seq-toggle font-serif text-[9px] ${hiddenBtnClass} border rounded px-1.5 py-0.5 cursor-pointer hover:opacity-80 transition-all">${hiddenBtnText}</button>
              <button data-seq-up="${i}" class="font-serif text-[10px] text-[#6b7680] hover:text-[#33393e] cursor-pointer bg-transparent border border-[#d3e0e4] rounded px-1 py-0.5 hover:border-[#6b7680] transition-all" title="Subir">↑</button>
              <button data-seq-down="${i}" class="font-serif text-[10px] text-[#6b7680] hover:text-[#33393e] cursor-pointer bg-transparent border border-[#d3e0e4] rounded px-1 py-0.5 hover:border-[#6b7680] transition-all" title="Bajar">↓</button>
              <button data-seq-delete="${i}" class="font-serif text-[10px] text-[#c4392b] hover:text-[#a32f23] cursor-pointer bg-transparent border border-[#d3e0e4] rounded px-1 py-0.5 hover:border-[#c4392b] transition-all" title="Eliminar">✖</button>
            </div>
          </div>
        `;
      }).join("");

      container.innerHTML = `
        <div class="bg-white border border-[#d3e0e4] rounded-[3px] mb-1">
          <div class="flex items-center gap-2 py-1 px-2 border-b border-[#e8edef] text-[10px] text-[#8b98a3] uppercase tracking-wider">
            <span class="w-5 text-right shrink-0">#</span>
            <span class="shrink-0">Ficha</span>
            <span class="shrink-0">Conf</span>
            <div class="flex items-center gap-1 ml-auto shrink-0">
              ${isFree ? '<span class="w-16 text-center">X</span><span class="w-16 text-center">Y</span>' : ""}
              <span class="w-12"></span>
              <span class="w-5"></span>
              <span class="w-5"></span>
              <span class="w-5"></span>
            </div>
          </div>
          ${rows}
        </div>
        <p class="text-[10px] text-[#8b98a3] font-mono">${sequence.length} fichas en secuencia</p>
      `;
    }

    document.getElementById("seq-operations")?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const toggleBtn = target.closest<HTMLButtonElement>("[data-seq-toggle]");
      if (toggleBtn) {
        const idx = parseInt(toggleBtn.dataset.seqToggle!);
        if (!isNaN(idx) && sequence[idx]) {
          sequence[idx].isHidden = !sequence[idx].isHidden;
          renderAll();
        }
        return;
      }

      const upBtn = target.closest<HTMLButtonElement>("[data-seq-up]");
      if (upBtn) {
        const idx = parseInt(upBtn.dataset.seqUp!);
        if (!isNaN(idx) && idx > 0 && sequence[idx]) {
          [sequence[idx - 1], sequence[idx]] = [sequence[idx], sequence[idx - 1]];
          renderAll();
        }
        return;
      }

      const downBtn = target.closest<HTMLButtonElement>("[data-seq-down]");
      if (downBtn) {
        const idx = parseInt(downBtn.dataset.seqDown!);
        if (!isNaN(idx) && idx < sequence.length - 1 && sequence[idx]) {
          [sequence[idx], sequence[idx + 1]] = [sequence[idx + 1], sequence[idx]];
          renderAll();
        }
        return;
      }

      const deleteBtn = target.closest<HTMLButtonElement>("[data-seq-delete]");
      if (deleteBtn) {
        const idx = parseInt(deleteBtn.dataset.seqDelete!);
        if (!isNaN(idx) && sequence[idx]) {
          sequence.splice(idx, 1);
          renderAll();
        }
        return;
      }
    });

    document.getElementById("seq-operations")?.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      if (!target.classList.contains("seq-free-input")) return;
      const idx = parseInt(target.dataset.seqIdx!);
      const field = target.dataset.seqField as "x" | "y";
      if (isNaN(idx) || !sequence[idx] || !field) return;
      sequence[idx][field] = parseInt(target.value) || 0;
      updatePreview();
    });

    document.getElementById("seq-operations")?.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      if (!target.classList.contains("seq-free-input")) return;
      const idx = parseInt(target.dataset.seqIdx!);
      const field = target.dataset.seqField as "x" | "y";
      if (isNaN(idx) || !sequence[idx] || !field) return;
      sequence[idx][field] = parseInt(target.value) || 0;
      updatePreview();
    });

    let dragState: { idx: number; startX: number; startY: number; origX: number; origY: number } | null = null;

    function initDragHandlers() {
      const preview = document.getElementById("seq-preview");
      if (!preview) return;

      preview.querySelectorAll<HTMLElement>("[data-seq-drag]").forEach((el) => {
        el.addEventListener("mousedown", (e) => {
          const idx = parseInt(el.dataset.seqDrag!);
          if (isNaN(idx) || !sequence[idx]) return;
          e.preventDefault();
          const tile = sequence[idx];
          dragState = {
            idx,
            startX: e.clientX,
            startY: e.clientY,
            origX: tile.x ?? 0,
            origY: tile.y ?? 0,
          };
          el.style.cursor = "grabbing";
        });
      });
    }

    document.addEventListener("mousemove", (e) => {
      if (!dragState) return;
      const dx = e.clientX - dragState.startX;
      const dy = e.clientY - dragState.startY;
      sequence[dragState.idx].x = dragState.origX + dx;
      sequence[dragState.idx].y = dragState.origY + dy;

      const el = document.querySelector<HTMLElement>(`[data-seq-drag="${dragState.idx}"]`);
      if (el) {
        el.style.left = `${sequence[dragState.idx].x}px`;
        el.style.top = `${sequence[dragState.idx].y}px`;
      }

      const opInputX = document.querySelector<HTMLInputElement>(`[data-seq-idx="${dragState.idx}"][data-seq-field="x"]`);
      const opInputY = document.querySelector<HTMLInputElement>(`[data-seq-idx="${dragState.idx}"][data-seq-field="y"]`);
      if (opInputX) opInputX.value = String(sequence[dragState.idx].x);
      if (opInputY) opInputY.value = String(sequence[dragState.idx].y);
    });

    document.addEventListener("mouseup", () => {
      if (!dragState) return;
      const el = document.querySelector<HTMLElement>(`[data-seq-drag="${dragState.idx}"]`);
      if (el) el.style.cursor = "grab";
      dragState = null;
    });

    function renderAll() {
      renderAvailableTiles();
      renderChain();
      currentLayout = readLayout();
      updatePreview();
      renderOperationsList();
    }

    document.getElementById("btn-add-tile")?.addEventListener("click", () => {
      const topSelect = document.getElementById("top-pip") as HTMLSelectElement;
      const bottomSelect = document.getElementById("bottom-pip") as HTMLSelectElement;
      const sizeSelect = document.getElementById("tile-size") as HTMLSelectElement;
      const top = parseInt(topSelect.value) as PipCount;
      const bottom = parseInt(bottomSelect.value) as PipCount;
      const size = sizeSelect.value as TileSize;
      availableTiles.push(createTile(top, bottom, "vertical", size));
      renderAvailableTiles();
    });

    document.getElementById("btn-generate-set")?.addEventListener("click", () => {
      availableTiles = buildFullSet(6);
      chain = [];
      renderAll();
    });

    document.getElementById("btn-shuffle")?.addEventListener("click", () => {
      availableTiles = shuffleTiles(availableTiles);
      renderAvailableTiles();
    });

    document.getElementById("btn-clear-chain")?.addEventListener("click", () => {
      const returnToAvailable = [...chain];
      chain = [];
      availableTiles = [...availableTiles, ...returnToAvailable];
      renderAll();
    });

    document.getElementById("btn-seq-add")?.addEventListener("click", () => {
      const top = parseInt((document.getElementById("seq-top") as HTMLSelectElement).value) as PipCount;
      const bottom = parseInt((document.getElementById("seq-bottom") as HTMLSelectElement).value) as PipCount;
      const size = (document.getElementById("seq-size") as HTMLSelectElement).value as TileSize;
      const orientation = (document.getElementById("seq-orientation") as HTMLSelectElement).value as TileOrientation;
      sequence.push(createTile(top, bottom, orientation, size));
      renderAll();
    });

    document.getElementById("btn-clear-sequence")?.addEventListener("click", () => {
      sequence = [];
      renderAll();
    });

    ["seq-layout", "seq-columns", "seq-gap"].forEach((id) => {
      document.getElementById(id)?.addEventListener("change", () => {
        currentLayout = readLayout();
        updatePreview();
        renderOperationsList();
      });
    });

    const ruleSelect = document.getElementById("pattern-rule") as HTMLSelectElement;
    const paramFraccionTop = document.getElementById("param-fraccion-top");
    const paramFraccionBottom = document.getElementById("param-fraccion-bottom");
    const paramConstante = document.getElementById("param-constante");

    function updateRuleParams() {
      const rule = ruleSelect.value;
      const isFraccion = rule === "fraccion";
      const isConstante = rule === "suma-constante";
      if (paramFraccionTop) paramFraccionTop.classList.toggle("hidden", !isFraccion);
      if (paramFraccionBottom) paramFraccionBottom.classList.toggle("hidden", !isFraccion);
      if (paramConstante) paramConstante.classList.toggle("hidden", !isConstante);
    }

    ruleSelect?.addEventListener("change", updateRuleParams);
    updateRuleParams();

    document.getElementById("btn-generate-pattern")?.addEventListener("click", () => {
      const ruleType = ruleSelect.value;
      const startTop = parseInt((document.getElementById("pattern-start-top") as HTMLSelectElement).value) as PipCount;
      const startBottom = parseInt((document.getElementById("pattern-start-bottom") as HTMLSelectElement).value) as PipCount;
      const length = parseInt((document.getElementById("pattern-length") as HTMLInputElement).value) || 9;
      const hideInput = (document.getElementById("pattern-hide") as HTMLInputElement).value;
      const hideIndices = hideInput ? hideInput.split(",").map(s => parseInt(s.trim())).filter(n => !isNaN(n)) : [];

      let rule: PatternRule;
      switch (ruleType) {
        case "fraccion":
          rule = {
            type: "fraccion",
            topDelta: parseInt((document.getElementById("pattern-top-delta") as HTMLInputElement).value) || 2,
            bottomDelta: parseInt((document.getElementById("pattern-bottom-delta") as HTMLInputElement).value) || 3,
          };
          break;
        case "suma-constante":
          rule = {
            type: "suma-constante",
            delta: parseInt((document.getElementById("pattern-delta") as HTMLInputElement).value) || 1,
          };
          break;
        case "espejo":
          rule = { type: "espejo" };
          break;
        case "encadenado-clasico":
          rule = { type: "encadenado-clasico" };
          break;
        default:
          rule = { type: "fraccion", topDelta: 2, bottomDelta: 3 };
      }

      sequence = generatePattern({
        rule,
        length,
        hideIndices,
        startTop,
        startBottom,
      });

      renderAll();
    });

    function downloadBlob(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }

    function renderExportSelection() {
      const container = document.getElementById("export-selection");
      if (!container) return;
      if (sequence.length === 0) {
        container.classList.add("hidden");
        return;
      }
      container.classList.remove("hidden");
      container.innerHTML = `
        <div class="bg-white border border-[#d3e0e4] rounded-[3px] p-2 max-h-[160px] overflow-y-auto">
          <p class="text-[10px] text-[#8b98a3] uppercase tracking-wider mb-1.5 px-1">Selecciona fichas para exportar</p>
          <div class="flex flex-wrap gap-1.5">
            ${sequence.map((tile, i) => {
              const label = tileLabel(tile);
              return `
                <label class="flex items-center gap-1 bg-[#f8fafb] border border-[#d3e0e4] rounded px-1.5 py-0.5 cursor-pointer hover:border-[#6b7680] transition-all">
                  <input type="checkbox" data-export-idx="${i}" class="export-checkbox w-3 h-3 accent-[#c4392b]" />
                  <span class="text-[10px] font-mono text-[#33393e]">${i + 1}. ${label}</span>
                </label>
              `;
            }).join("")}
          </div>
        </div>
      `;
    }

    const exportModeSelect = document.getElementById("export-mode") as HTMLSelectElement;
    const exportSegmentWrap = document.getElementById("export-segment-wrap");
    const exportSelectionDiv = document.getElementById("export-selection");

    exportModeSelect?.addEventListener("change", () => {
      const mode = exportModeSelect.value;
      if (exportSegmentWrap) exportSegmentWrap.classList.toggle("hidden", mode !== "segmentado");
      if (mode === "seleccion") {
        renderExportSelection();
      } else {
        exportSelectionDiv?.classList.add("hidden");
      }
    });

    document.getElementById("btn-export")?.addEventListener("click", async () => {
      const btn = document.getElementById("btn-export") as HTMLButtonElement;
      if (!btn || sequence.length === 0) return;

      const mode = exportModeSelect.value;
      const ghost = document.getElementById("export-ghost");
      if (!ghost) return;

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = "Exportando...";

      try {
        let exportConfig: PartialExportConfig;
        if (mode === "seleccion") {
          const checkboxes = document.querySelectorAll<HTMLInputElement>(".export-checkbox:checked");
          const indices = Array.from(checkboxes).map((cb) => parseInt(cb.dataset.exportIdx!)).filter((n) => !isNaN(n));
          if (indices.length === 0) { btn.textContent = originalText; btn.disabled = false; return; }
          exportConfig = { mode: "seleccion", indices };
        } else if (mode === "segmentado") {
          const segSize = parseInt((document.getElementById("export-segment-size") as HTMLInputElement)?.value) || 4;
          exportConfig = { mode: "segmentado", segmentSize: segSize };
        } else {
          exportConfig = { mode: "completa" };
        }

        const subsets = getSubsets(sequence, exportConfig);
        const blobs: Blob[] = [];

        for (const subset of subsets) {
          const html = renderLayoutHTML(subset, currentLayout);
          ghost.innerHTML = html;
          await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
          const blob = await toBlob(ghost, { pixelRatio: 2 });
          if (blob) blobs.push(blob);
          ghost.innerHTML = "";
        }

        if (blobs.length === 0) return;

        if (blobs.length === 1) {
          downloadBlob(blobs[0], "dominos-layout.png");
        } else {
          const zip = new JSZip();
          blobs.forEach((blob, i) => {
            zip.file(`pregunta-${i + 1}.png`, blob);
          });
          const zipBlob = await zip.generateAsync({ type: "blob" });
          downloadBlob(zipBlob, "set-dominos.zip");
        }
      } catch (err) {
        console.error("Export failed:", err);
      } finally {
        btn.textContent = originalText;
        btn.disabled = false;
      }
    });

    renderAll();
  </script>
</BaseLayout>
