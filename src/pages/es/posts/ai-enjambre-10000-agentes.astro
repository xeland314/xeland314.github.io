---
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";
import RadiographyHeader from "../../../components/blog/RadiographyHeader.astro";
import RadiographyLegend from "../../../components/blog/RadiographyLegend.astro";
import PostFooterBar from "../../../components/blog/PostFooterBar.astro";

const title = "¿Cómo trabajan 10.000 agentes?";
const description = "Radiografía del enjambre: arquitectura distribuida de agentes → ideas → intercambio → selección → prueba formal.";
---

<BlogPostLayout
  title={title}
  description={description}
  bgColor="bg-slate-950"
  extraFonts="&family=Fira+Code:wght@400;700"
  lang="es"
>
  <div class="relative p-6 md:p-10 flex flex-col text-white overflow-hidden h-full">
    <div class="absolute top-4 right-4 z-50 flex gap-2">
      <span class="glass-tag px-2 py-1 rounded text-violet-400 text-[10px] font-bold tracking-widest">SERIE: NAVIER-STOKES × IA · 2/6 · PRIORIDAD</span>
    </div>

    <RadiographyHeader
      categoryText="Sistemas Distribuidos"
      categoryColorClass="text-violet-400"
      titlePrefix="Radiografía:"
      titleHighlightText="Enjambre 10K"
      titleHighlightColorClass="text-cyan-400"
      subtitle="Arquitectura agente → idea → crítica → selección"
    />

    <!-- Main architecture diagram -->
    <div class="feature-card rounded-3xl p-5 mb-4">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-slate-400 text-xs font-bold uppercase tracking-widest">Arquitectura del swarm — vista developer</h3>
        <span class="text-[10px] font-mono bg-violet-500/20 text-violet-300 px-2 py-1 rounded">map → shuffle → reduce</span>
      </div>

      <!-- 4 stages -->
      <div class="grid grid-cols-4 gap-3">
        <!-- Stage 1 -->
        <div class="bg-slate-900 rounded-2xl p-3 border border-white/10 flex flex-col">
          <div class="w-10 h-10 rounded-xl bg-violet-500 flex items-center justify-center text-xl mb-2">🧠</div>
          <p class="text-violet-400 font-black text-xs uppercase">1. Spawn</p>
          <p class="text-white font-bold text-[11px] mt-1">10.000 agentes</p>
          <p class="text-slate-400 text-[10px] leading-snug mt-1">LLMs con prompts diversos: analista, crítico, formalizador, simulador.</p>
          <div class="mt-3 bg-black/40 rounded-lg p-2 font-mono text-[9px] leading-relaxed">
            <p class="text-slate-500"># pool inicial</p>
            <p class="text-violet-300">agents = [Agent(role=r)</p>
            <p class="text-violet-300"> for r in ROLES for _ in 0..N]</p>
          </div>
          <div class="mt-auto pt-3 flex gap-1 flex-wrap">
            <span class="bg-violet-500/20 text-violet-300 text-[9px] px-1.5 py-0.5 rounded">temperature 0.7–1.2</span>
          </div>
        </div>

        <!-- Stage 2 -->
        <div class="bg-slate-900 rounded-2xl p-3 border border-white/10 flex flex-col">
          <div class="w-10 h-10 rounded-xl bg-sky-500 flex items-center justify-center text-xl mb-2">💡</div>
          <p class="text-sky-400 font-black text-xs uppercase">2. Generate</p>
          <p class="text-white font-bold text-[11px] mt-1">Ideas divergentes</p>
          <p class="text-slate-400 text-[10px] leading-snug mt-1">Cada agente propone lemas, construcciones de blow-up, estimaciones de energía.</p>
          <div class="mt-3 bg-black/40 rounded-lg p-2 font-mono text-[9px] leading-relaxed">
            <p class="text-slate-500"># fan-out</p>
            <p>idea = agent.propose(</p>
            <p class="pl-2 text-sky-300">context=paper_memory,</p>
            <p class="pl-2 text-sky-300">seed=random_pdf)</p>
          </div>
          <p class="text-[10px] text-slate-500 mt-2 italic">~100K ideas / iteración</p>
        </div>

        <!-- Stage 3 -->
        <div class="bg-slate-900 rounded-2xl p-3 border border-sky-500/20 flex flex-col">
          <div class="w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center text-xl mb-2">🔄</div>
          <p class="text-amber-400 font-black text-xs uppercase">3. Exchange & Critic</p>
          <p class="text-white font-bold text-[11px] mt-1">Torneo cruzado</p>
          <p class="text-slate-400 text-[10px] leading-snug mt-1">Otros agentes buscan contraejemplos, verifican con Lean parcial y CFD numérico.</p>
          <div class="mt-3 bg-amber-950/30 rounded-lg p-2 font-mono text-[9px] leading-relaxed border border-amber-500/20">
            <p class="text-amber-300">score = critics.vote(idea)</p>
            <p class="text-slate-400">if score &lt; τ: prune()</p>
            <p class="text-emerald-300">else: promote()</p>
          </div>
          <p class="text-[10px] text-amber-300/70 mt-2">✂ 95% podado aquí</p>
        </div>

        <!-- Stage 4 -->
        <div class="bg-gradient-to-br from-emerald-950/50 to-teal-950/40 rounded-2xl p-3 border border-emerald-500/30 flex flex-col">
          <div class="w-10 h-10 rounded-xl bg-emerald-500 flex items-center justify-center text-xl mb-2">✅</div>
          <p class="text-emerald-400 font-black text-xs uppercase">4. Select</p>
          <p class="text-white font-bold text-[11px] mt-1">Resultado</p>
          <p class="text-slate-300 text-[10px] leading-snug mt-1">Top 0.1% → refinamiento profundo + formalización Lean completa.</p>
          <div class="mt-3 bg-black/40 rounded-lg p-2 font-mono text-[9px] leading-relaxed">
            <p class="text-emerald-300">lean_check(proof)</p>
            <p class="text-slate-400">→ Q.E.D. verificada</p>
          </div>
          <div class="mt-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-emerald-300 text-[10px] font-bold">1 prueba sobrevive</span>
          </div>
        </div>
      </div>

      <!-- Flow arrows -->
      <div class="flex justify-center gap-12 mt-3 text-slate-500 text-xs">
        <span>→ → →</span><span>→ → →</span><span>→ → →</span>
      </div>
    </div>

    <!-- Developer analogy -->
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div class="feature-card rounded-2xl p-4">
        <h3 class="text-violet-400 font-black text-xs uppercase tracking-widest mb-3">Analogía developer: no es un LLM gigante</h3>
        <div class="space-y-2 text-xs">
          <div class="flex gap-3 items-center bg-slate-900 rounded-xl p-3 border border-white/5">
            <span class="text-lg">☸️</span>
            <div>
              <p class="text-white font-bold">Kubernetes Jobs</p>
              <p class="text-slate-400 text-[11px]">10K pods efímeros, cada uno con un prompt distinto. Orquestador hace scheduling + healthchecks.</p>
            </div>
          </div>
          <div class="flex gap-3 items-center bg-slate-900 rounded-xl p-3 border border-white/5">
            <span class="text-lg">🗺️</span>
            <div>
              <p class="text-white font-bold">MapReduce</p>
              <p class="text-slate-400 text-[11px]"><span class="text-violet-300">Map:</span> genera ideas · <span class="text-amber-300">Shuffle:</span> intercambio · <span class="text-emerald-300">Reduce:</span> selección.</p>
            </div>
          </div>
          <div class="flex gap-3 items-center bg-slate-900 rounded-xl p-3 border border-white/5">
            <span class="text-lg">🌿</span>
            <div>
              <p class="text-white font-bold">Evolución / Genetic</p>
              <p class="text-slate-400 text-[11px]">Mutación (prompt temp alta) + cruce (mezcla de ideas) + fitness (Lean + crítica).</p>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <div class="bg-slate-900 rounded-2xl p-4 border border-white/10">
          <h4 class="text-sky-400 font-bold text-xs uppercase tracking-widest mb-2">Números que importan</h4>
          <div class="grid grid-cols-3 gap-3 text-center">
            <div class="bg-white/5 rounded-xl p-3">
              <p class="text-2xl font-black text-white">10K</p>
              <p class="text-[10px] text-slate-400 uppercase font-bold">agentes</p>
              <p class="text-[10px] text-slate-500">concurrentes</p>
            </div>
            <div class="bg-white/5 rounded-xl p-3">
              <p class="text-2xl font-black text-white">~100K</p>
              <p class="text-[10px] text-slate-400 uppercase font-bold">ideas</p>
              <p class="text-[10px] text-slate-500">por ronda</p>
            </div>
            <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-3">
              <p class="text-2xl font-black text-emerald-400">1</p>
              <p class="text-[10px] text-emerald-300 uppercase font-bold">proof</p>
              <p class="text-[10px] text-slate-500">verificada</p>
            </div>
          </div>
          <p class="text-slate-500 text-[10px] mt-3 text-center italic">El poder no está en el modelo, está en el proceso de selección.</p>
        </div>
        <div class="glass-tag p-4 rounded-xl border-l-4 border-violet-500">
          <h4 class="text-violet-400 font-bold text-xs uppercase tracking-widest mb-1">Para tu contenido</h4>
          <p class="text-slate-200 text-xs leading-snug">Visualiza esto como <span class="text-white font-bold">diagrama de flujo distribuido</span>, no como fluido girando. Es lo que ningún otro creador está mostrando.</p>
        </div>
      </div>
    </div>

    <RadiographyLegend
      items={[
        { bgColor: "bg-violet-500", shadowRgba: "rgba(139,92,246,0.5)", textColor: "text-violet-400", title: "Divergencia", description: "Generar mucho<br>sin miedo al error" },
        { bgColor: "bg-amber-500", shadowRgba: "rgba(245,158,11,0.5)", textColor: "text-amber-400", title: "Crítica", description: "Intercambio brutal<br>poda 95%" },
        { bgColor: "bg-emerald-500", shadowRgba: "rgba(16,185,129,0.5)", textColor: "text-emerald-400", title: "Convergencia", description: "Solo lo verificable<br>sobrevive" },
      ]}
      gap="gap-4 md:gap-12"
      minWidth="min-w-[200px]"
    />

    <PostFooterBar
      middleHtml='<span class="text-violet-400 font-black italic">SPAWN</span> masivo • <span class="text-amber-400 font-black italic">CRITIC</span> feroz • <span class="text-emerald-400 font-black italic">PROOF</span> única.'
    />
  </div>

  <style>
    .feature-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); }
    .glass-tag { background: rgba(139,92,246,0.06); border: 1px solid rgba(139,92,246,0.18); }
  </style>
</BlogPostLayout>
