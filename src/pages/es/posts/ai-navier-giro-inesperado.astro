---
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";
import RadiographyHeader from "../../../components/blog/RadiographyHeader.astro";
import RadiographyLegend from "../../../components/blog/RadiographyLegend.astro";
import PostFooterBar from "../../../components/blog/PostFooterBar.astro";

const title = "El Giro Inesperado — De 5 Problemas a Navier-Stokes";
const description = "Radiografía: Cómo OpenAI pasó de atacar en paralelo varios problemas del milenio a concentrar su enjambre de IA en Navier-Stokes.";
---

<BlogPostLayout
  title={title}
  description={description}
  bgColor="bg-slate-950"
  extraFonts="&family=Fira+Code:wght@400;700"
  lang="es"
>
  <div class="relative p-6 md:p-10 flex flex-col text-white overflow-hidden h-full">
    <div class="absolute top-4 right-4 z-50 flex gap-2">
      <span class="glass-tag px-2 py-1 rounded text-amber-400 text-[10px] font-bold tracking-widest">SERIE: NAVIER-STOKES × IA · 1/6</span>
    </div>

    <RadiographyHeader
      categoryText="IA como Investigador"
      categoryColorClass="text-amber-400"
      titlePrefix="Radiografía:"
      titleHighlightText="El Giro Inesperado"
      titleHighlightColorClass="text-sky-400"
      subtitle="De exploración masiva a foco quirúrgico en Navier–Stokes"
    />

    <!-- TOP: Timeline funnel -->
    <div class="feature-card rounded-3xl p-5 mb-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-slate-400 text-xs font-bold uppercase tracking-widest">Pipeline de investigación</h3>
        <span class="text-[10px] font-mono bg-amber-500/20 text-amber-300 px-2 py-1 rounded">Funnel de problemas</span>
      </div>
      <!-- Funnel visualization -->
      <div class="grid grid-cols-[1fr_auto_1fr] gap-3 items-center">
        <!-- Left: Inicio divergente -->
        <div class="bg-slate-900 rounded-2xl p-4 border border-white/10">
          <p class="text-amber-400 font-black text-xs uppercase tracking-widest mb-2">Fase 1 · Exploración</p>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-[11px]"><span class="w-2 h-2 rounded-full bg-rose-500"></span><span class="text-slate-300">Navier–Stokes (blow-up vs regularidad)</span></div>
            <div class="flex items-center gap-2 text-[11px]"><span class="w-2 h-2 rounded-full bg-blue-500"></span><span class="text-slate-300">Hipótesis de Erdős</span></div>
            <div class="flex items-center gap-2 text-[11px]"><span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="text-slate-300">Continuum / forcing</span></div>
            <div class="flex items-center gap-2 text-[11px]"><span class="w-2 h-2 rounded-full bg-purple-500"></span><span class="text-slate-300">Problemas IMO-style</span></div>
            <div class="flex items-center gap-2 text-[11px]"><span class="w-2 h-2 rounded-full bg-amber-500"></span><span class="text-slate-300">Otros Millenium candidatos</span></div>
          </div>
          <p class="text-slate-500 text-[10px] mt-3 italic">10.000 agentes en paralelo · breadth-first search</p>
        </div>

        <div class="flex flex-col items-center">
          <span class="text-2xl">→</span>
          <div class="bg-sky-500 text-white text-[10px] font-black px-3 py-1.5 rounded-full -rotate-2">PRUNING</div>
          <span class="text-[10px] text-slate-500 mt-1">métrica: tracción</span>
          <span class="text-2xl mt-1">→</span>
        </div>

        <!-- Right: Foco -->
        <div class="bg-gradient-to-br from-sky-950/60 to-blue-950/60 rounded-2xl p-4 border border-sky-500/30">
          <p class="text-sky-400 font-black text-xs uppercase tracking-widest mb-2">Fase 2 · Convergencia</p>
          <div class="bg-slate-900 rounded-xl p-3 border border-sky-500/20">
            <p class="text-white font-black text-lg leading-none">Navier–Stokes</p>
            <p class="text-sky-300 font-mono text-xs mt-1">∂u/∂t + (u·∇)u = -∇p + νΔu</p>
            <p class="text-slate-400 text-[10px] mt-1">Conjetura de construcción de blow-up finito</p>
          </div>
          <div class="mt-3 flex gap-2">
            <span class="bg-emerald-500/20 text-emerald-300 text-[10px] px-2 py-1 rounded font-bold">✓ Lean verificado</span>
            <span class="bg-amber-500/20 text-amber-300 text-[10px] px-2 py-1 rounded font-bold">↻ 80% swarm reasignado</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Middle: Por qué pivotaron + Investigador vs Chatbot -->
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div class="space-y-3">
        <div class="glass-tag p-4 rounded-xl border-l-4 border-amber-400">
          <h4 class="text-amber-400 font-black text-xs uppercase tracking-widest mb-1">¿Por qué Navier–Stokes ganó?</h4>
          <ul class="text-slate-200 text-xs leading-relaxed space-y-1">
            <li>→ <span class="text-white font-bold">Tracción técnica:</span> los agentes generaban contraejemplos parciales testeables vía simulación.</li>
            <li>→ <span class="text-white font-bold">Feedback rápido:</span> PDE + CFD = validación numérica inmediata (vs. combinatoria pura).</li>
            <li>→ <span class="text-white font-bold">Puente a Lean:</span> análisis funcional es formalizable en Mathlib.</li>
          </ul>
        </div>
        <div class="feature-card p-4 rounded-xl">
          <h4 class="text-sky-400 font-bold text-xs uppercase tracking-widest mb-1">No fue suerte, fue selección natural</h4>
          <p class="text-slate-400 text-xs leading-snug">Como en un <span class="text-white font-bold">genetic algorithm</span>: las líneas con más “fitness” (lemas demostrables + refutables) sobrevivieron. Las otras se podaron.</p>
        </div>
      </div>

      <div class="feature-card rounded-2xl p-4 flex flex-col">
        <h3 class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">IA Investigador vs IA Chatbot</h3>
        <div class="grid grid-cols-2 gap-3 text-[11px] leading-snug">
          <div class="bg-rose-500/10 border border-rose-500/20 rounded-xl p-3">
            <p class="text-rose-400 font-black uppercase text-[11px] mb-1">✕ Chatbot</p>
            <p class="text-slate-400">Responde prompt único</p>
            <p class="text-slate-400">Optimiza por parecer correcto</p>
            <p class="text-slate-400">Sin memoria largo plazo</p>
          </div>
          <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-3">
            <p class="text-emerald-400 font-black uppercase text-[11px] mb-1">✓ Investigador</p>
            <p class="text-slate-200 font-bold">Genera → testea → refuta</p>
            <p class="text-slate-200">Optimiza por prueba formal</p>
            <p class="text-slate-200">Memoria vía enjambre</p>
          </div>
        </div>
        <div class="mt-3 bg-slate-900 rounded-xl p-3 border border-white/10 font-mono text-[10px] leading-relaxed">
          <p class="text-slate-500">// loop del investigador</p>
          <p><span class="text-purple-400">while</span> (!proof_verified) {"{"}</p>
          <p class="pl-3">idea = agent.generate(seed)</p>
          <p class="pl-3">counter = swarm.criticize(idea)</p>
          <p class="pl-3">lean = formalize(idea, counter)</p>
          <p>{"}"}</p>
        </div>
      </div>
    </div>

    <RadiographyLegend
      items={[
        { bgColor: "bg-amber-500", shadowRgba: "rgba(245,158,11,0.5)", textColor: "text-amber-400", title: "Exploración", description: "Amplitud inicial<br>muchos frentes" },
        { bgColor: "bg-sky-500", shadowRgba: "rgba(14,165,233,0.5)", textColor: "text-sky-400", title: "Selección", description: "Tracción medible<br>poda automática" },
        { bgColor: "bg-emerald-500", shadowRgba: "rgba(16,185,129,0.5)", textColor: "text-emerald-400", title: "Convergencia", description: "Foco total<br>en blow-up" },
      ]}
      gap="gap-4 md:gap-8"
      minWidth="min-w-[180px]"
    />

    <PostFooterBar
      middleHtml='<span class="text-amber-400 font-black italic">BREADTH</span> explora • <span class="text-sky-400 font-black italic">FITNESS</span> filtra • <span class="text-emerald-400 font-black italic">DEPTH</span> resuelve.'
    />
  </div>

  <style>
    .feature-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); }
    .glass-tag { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); }
  </style>
</BlogPostLayout>
