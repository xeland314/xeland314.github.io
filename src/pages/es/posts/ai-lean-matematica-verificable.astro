---
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";
import RadiographyHeader from "../../../components/blog/RadiographyHeader.astro";
import RadiographyLegend from "../../../components/blog/RadiographyLegend.astro";
import PostFooterBar from "../../../components/blog/PostFooterBar.astro";

const title = "De Matemática a Código Verificable";
const description = "Radiografía Lean 4: cómo una demostración se compila y el verificador prueba que no hay errores lógicos — como un type checker para teoremas.";
---

<BlogPostLayout
  title={title}
  description={description}
  bgColor="bg-slate-950"
  extraFonts="&family=Fira+Code:wght@400;700"
  lang="es"
>
  <div class="relative p-6 md:p-10 flex flex-col text-white overflow-hidden h-full">
    <div class="absolute top-4 right-4 z-50 flex gap-2">
      <span class="glass-tag px-2 py-1 rounded text-emerald-400 text-[10px] font-bold tracking-widest">SERIE: NAVIER-STOKES × IA · 3/6 · PRIORIDAD</span>
    </div>

    <RadiographyHeader
      categoryText="Matemática Formal"
      categoryColorClass="text-emerald-400"
      titlePrefix="Radiografía:"
      titleHighlightText="Lean 4"
      titleHighlightColorClass="text-sky-400"
      subtitle="Cuando una prueba se compila como código"
    />

    <!-- Top: Paper vs Lean -->
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div class="feature-card rounded-3xl p-5">
        <h3 class="text-rose-400 font-black text-xs uppercase tracking-widest mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span> Antes: Paper tradicional
        </h3>
        <div class="bg-slate-900 rounded-xl p-4 border border-white/10 font-serif text-sm leading-relaxed">
          <p class="text-slate-300 italic">"Es claro que existe una constante C tal que ‖u‖ ≤ C..."</p>
          <p class="text-slate-500 text-xs mt-2">→ El revisor humano debe creer el salto lógico.</p>
          <p class="text-slate-500 text-xs">→ Errores pueden esconderse 10 páginas después.</p>
          <p class="text-slate-500 text-xs">→ 2–3 revisores, meses de espera.</p>
        </div>
        <div class="mt-3 flex gap-2">
          <span class="bg-rose-500/20 text-rose-300 text-[10px] px-2 py-1 rounded font-bold">✕ No compilable</span>
          <span class="bg-rose-500/20 text-rose-300 text-[10px] px-2 py-1 rounded font-bold">✕ No testeable</span>
        </div>
      </div>

      <div class="feature-card rounded-3xl p-5 border border-emerald-500/20 bg-emerald-950/10">
        <h3 class="text-emerald-400 font-black text-xs uppercase tracking-widest mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Ahora: Lean 4 verificado
        </h3>
        <div class="bg-black rounded-xl p-4 border border-emerald-500/20 font-mono text-[11px] leading-relaxed">
          <p class="text-slate-500">-- Lean 4 + Mathlib</p>
          <p><span class="text-purple-400">theorem</span> <span class="text-sky-300">navierStokes_blowUp</span></p>
          <p class="pl-2 text-slate-400">(u₀ : VectorField) (hν : ν &gt; 0) :</p>
          <p class="pl-2 text-slate-300">∃ (T* : ℝ) (u : Solution), T* &lt; ∞ ∧</p>
          <p class="pl-2 text-emerald-300">BlowUpAt u T* := <span class="text-slate-500">by</span></p>
          <p class="pl-4 text-slate-400">· <span class="text-amber-300">have</span> h1 : EnergyBound u₀ := by</p>
          <p class="pl-6 text-slate-500">simp [energy_estimate]</p>
          <p class="pl-4 text-slate-400">· <span class="text-amber-300">exact</span> blowUp_construction h1 hν</p>
        </div>
        <div class="mt-3 flex gap-2">
          <span class="bg-emerald-500/20 text-emerald-300 text-[10px] px-2 py-1 rounded font-bold">✓ Type-checked</span>
          <span class="bg-emerald-500/20 text-emerald-300 text-[10px] px-2 py-1 rounded font-bold">✓ CI verde</span>
        </div>
      </div>
    </div>

    <!-- Middle: Anatomía de prueba + Compilador -->
    <div class="grid grid-cols-[1.2fr_0.8fr] gap-4 mb-4">
      <div class="feature-card rounded-2xl p-5">
        <h3 class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">Anatomía de una prueba formal</h3>
        <div class="grid grid-cols-4 gap-2 text-center">
          <div class="bg-slate-900 rounded-xl p-3 border border-white/10">
            <p class="text-sky-400 font-black text-xs">THEOREM</p>
            <p class="text-slate-400 text-[10px] mt-1">Qué afirmas</p>
            <p class="text-white font-mono text-[10px] mt-2 bg-white/5 rounded px-1 py-1">∃ T* &lt; ∞</p>
            <p class="text-slate-500 text-[9px] mt-1">como firma de función</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 border border-white/10">
            <p class="text-amber-400 font-black text-xs">HYPOTHESIS</p>
            <p class="text-slate-400 text-[10px] mt-1">Qué asumes</p>
            <p class="text-white font-mono text-[10px] mt-2 bg-white/5 rounded px-1 py-1">ν &gt; 0, u₀ suave</p>
            <p class="text-slate-500 text-[9px] mt-1">como parámetros</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 border border-emerald-500/20">
            <p class="text-emerald-400 font-black text-xs">PROOF</p>
            <p class="text-slate-400 text-[10px] mt-1">Cómo lo pruebas</p>
            <p class="text-white font-mono text-[10px] mt-2 bg-emerald-500/10 rounded px-1 py-1 border border-emerald-500/20">by simp; exact</p>
            <p class="text-slate-500 text-[9px] mt-1">como implementación</p>
          </div>
          <div class="bg-slate-900 rounded-xl p-3 border border-white/10">
            <p class="text-violet-400 font-black text-xs">QED</p>
            <p class="text-slate-400 text-[10px] mt-1">Verificación</p>
            <p class="text-white font-mono text-[10px] mt-2 bg-violet-500/10 rounded px-1 py-1">✓ kernel</p>
            <p class="text-slate-500 text-[9px] mt-1">como compiler</p>
          </div>
        </div>
        <div class="mt-4 bg-slate-900 rounded-xl p-3 border border-white/10 flex items-center gap-3">
          <span class="text-xl">🔍</span>
          <div>
            <p class="text-white font-bold text-xs">Si hay un gap lógico, no compila.</p>
            <p class="text-slate-400 text-[11px]">Como olvidar un `;` en C o un `unwrap()` sin `Option` en Rust — el kernel de Lean es el `rustc` de las matemáticas.</p>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <div class="bg-black rounded-2xl p-4 border border-white/10 font-mono text-[11px] leading-relaxed">
          <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-2 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Terminal
          </p>
          <p class="text-slate-500">$ lake build</p>
          <p class="text-emerald-400">✔ [42/42] Built navierStokes.blowUp</p>
          <p class="text-slate-500">$ lake exe check</p>
          <p class="text-emerald-400">✓ Proof verified</p>
          <p class="text-slate-500">  0 errors, 0 warnings</p>
          <p class="text-slate-500 mt-2">$ git diff --stat</p>
          <p class="text-sky-300"> Mathlib/Analysis/PDE/... | +2,340</p>
        </div>
        <div class="glass-tag p-4 rounded-xl border-l-4 border-emerald-500">
          <h4 class="text-emerald-400 font-bold text-xs uppercase tracking-widest mb-1">Por qué importa para devs</h4>
          <p class="text-slate-200 text-xs leading-snug">Pasas de <span class="text-white font-bold">confiar en humanos</span> a <span class="text-white font-bold">confiar en un verificador determinista</span>. Es el mismo salto que de test manual a CI con 100% coverage.</p>
        </div>
      </div>
    </div>

    <RadiographyLegend
      items={[
        { bgColor: "bg-sky-500", shadowRgba: "rgba(14,165,233,0.5)", textColor: "text-sky-400", title: "Declarativo", description: "Qué debe ser cierto<br>firma del teorema" },
        { bgColor: "bg-amber-500", shadowRgba: "rgba(245,158,11,0.5)", textColor: "text-amber-400", title: "Tácticas", description: "Cómo se demuestra<br>simp, exact, have" },
        { bgColor: "bg-emerald-500", shadowRgba: "rgba(16,185,129,0.5)", textColor: "text-emerald-400", title: "Kernel", description: "Verificador final<br>no miente" },
      ]}
      gap="gap-4 md:gap-12"
      minWidth="min-w-[200px]"
    />

    <PostFooterBar
      middleHtml='<span class="text-sky-400 font-black italic">THEOREM</span> tipa • <span class="text-amber-400 font-black italic">TACTICS</span> implementa • <span class="text-emerald-400 font-black italic">KERNEL</span> verifica.'
    />
  </div>

  <style>
    .feature-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); }
    .glass-tag { background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.18); }
  </style>
</BlogPostLayout>
