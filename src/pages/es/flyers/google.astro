---
// Volante A4 · Educativo: negocio en Google + opiniones con QR
import BaseLayout from "../../../layouts/BaseLayout.astro";

const siteTitle = "Su negocio en Google | Christopher Villamarín";
const siteDescription =
  "Por qué su negocio no aparece en Google y cómo arreglarlo: registro oficial, fotos, horarios y opiniones de clientes con código QR. Quito, Ecuador.";
const siteKeywords =
  "negocio en google, reseñas google, mapa google negocio, volante Quito, Christopher Villamarín";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/es/flyers/google";
const siteImage = "https://xeland314.github.io/images/preview-es.jpg";

const CURRENT = "google";

const navItems = [
  { slug: "general", label: "General", href: "/es/flyers/general" },
  { slug: "google", label: "Google", href: "/es/flyers/google" },
  { slug: "cotizacion", label: "Cotización", href: "/es/flyers/cotizacion" },
];

const mitos = [
  "Mi negocio ya existe, Google ya me conoce.",
  "Con tener página de Facebook es suficiente.",
  "Las opiniones de clientes no afectan mis ventas.",
  "Aparecer en Google es suerte o hay que pagarle a Google.",
];

const realidades = [
  "Alguien tiene que registrar su negocio y confirmar que existe. Eso lo hago yo por usted.",
  "Un perfil completo — fotos, horarios, ubicación — aparece antes que uno abandonado.",
  "Las opiniones recientes suben su puesto en las búsquedas y dan confianza al que llega.",
  "No se le paga a Google por aparecer; se construye paso a paso.",
];

const pasosGoogle = [
  {
    n: "1",
    t: "Lo registro en Google",
    d: "Nombre oficial, dirección en el mapa, horarios, teléfono y categoría correcta.",
  },
  {
    n: "2",
    t: "Le doy buena cara",
    d: "Subimos fotos reales de su local, productos y servicios, bien descritos.",
  },
  {
    n: "3",
    t: "Cartelito con código QR",
    d: "Para la caja o la vitrina: su cliente lo escanea y deja su opinión en menos de un minuto. Usted elige el diseño y yo lo imprimo listo para pegar.",
  },
  {
    n: "4",
    t: "Capacito a su personal",
    d: "Una sesión práctica para que aprendan a pedir opiniones sin incomodar al cliente y a contestarlas bien.",
  },
  {
    n: "5",
    t: "Revisión periódica opcional",
    d: "Si quiere, vuelvo cada mes para refrescar fotos, responder pendientes y corregir horarios de temporada.",
  },
];
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
  robots="noindex, nofollow"
>
  <main class="min-h-screen bg-gray-100 dark:bg-gray-950 py-8 px-4 print:!p-0 print:!bg-white">
    <!-- Barra de herramientas: SOLO pantalla -->
    <div class="flyer-toolbar max-w-[210mm] mx-auto mb-5 flex items-center justify-between gap-3 flex-wrap print:hidden">
      <div class="flex items-center gap-1 bg-white dark:bg-gray-800 rounded-full p-1 shadow-sm border border-gray-200 dark:border-gray-700">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "text-xs font-bold px-3 py-1.5 rounded-full transition-colors",
                CURRENT === item.slug
                  ? "bg-blue-600 text-white"
                  : "text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <button
        onclick="window.print()"
        class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 active:scale-95 text-white text-sm font-bold px-5 py-2 rounded-full shadow-lg shadow-blue-600/25 transition-all"
      >
        Imprimir · Guardar PDF
      </button>
    </div>

    <!-- Hoja A4 -->
    <div class="overflow-x-auto pb-10 print:overflow-visible print:pb-0">
      <div
        class="flyer-sheet w-[210mm] h-[297mm] mx-auto bg-white text-gray-900 shadow-xl shadow-gray-400/30 rounded-xl print:shadow-none print:rounded-none"
      >
        <div class="w-full h-full flex flex-col px-[14mm] pt-[9mm] pb-[7mm]">
          <!-- Cabecera -->
          <div class="flex items-center justify-between pb-[4mm] border-b border-gray-200">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
              <p class="text-[8pt] font-extrabold tracking-[0.14em] uppercase text-gray-800">
                Christopher Villamarín
              </p>
            </div>
            <p class="text-[9pt] font-extrabold text-gray-800">📞 098 712 9357</p>
          </div>

          <!-- Titular -->
          <div class="pt-[7mm]">
            <h1 class="text-[21pt] font-black leading-[1.15] tracking-tight text-gray-900 max-w-[175mm]">
              Su cliente lo buscó en Google…<br />
              y encontró a su <span class="text-blue-700">competencia.</span>
            </h1>
            <p class="mt-[3mm] text-[9.5pt] text-gray-600 leading-relaxed max-w-[170mm]">
              Cuando alguien necesita un taller, una tienda o un restaurante,
              lo primero que hace es buscarlo en el celular. Si su negocio no
              aparece ahí, para ese cliente prácticamente no existe.
            </p>
          </div>

          <!-- Mitos vs realidad -->
          <div class="mt-[6mm] grid grid-cols-2 gap-[4mm]">
            <div class="border border-red-200 rounded-xl p-[4mm]">
              <p class="flex items-center gap-2 text-[8pt] font-extrabold tracking-[0.14em] uppercase text-red-600 mb-[2.5mm]">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                Lo que casi todos creen
              </p>
              <ul class="space-y-[2mm]">
                {
                  mitos.map((m) => (
                    <li class="flex gap-[2mm] text-[8pt] text-gray-700 leading-snug">
                      <span class="text-red-500 font-black shrink-0">✗</span>
                      <span>{m}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="border border-green-200 rounded-xl p-[4mm]">
              <p class="flex items-center gap-2 text-[8pt] font-extrabold tracking-[0.14em] uppercase text-green-700 mb-[2.5mm]">
                <span class="w-2 h-2 rounded-full bg-green-600"></span>
                Lo que realmente pasa
              </p>
              <ul class="space-y-[2mm]">
                {
                  realidades.map((r) => (
                    <li class="flex gap-[2mm] text-[8pt] text-gray-700 leading-snug">
                      <span class="text-green-600 font-black shrink-0">✓</span>
                      <span>{r}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <!-- Qué haría por su negocio -->
          <div class="mt-[6mm] flex-1">
            <div class="flex items-center gap-3 mb-[3mm]">
              <h2 class="text-[11.5pt] font-black tracking-tight text-gray-900 whitespace-nowrap">
                ¿Qué haría yo por su negocio?
              </h2>
              <span class="h-px flex-1 bg-gray-200"></span>
            </div>

            <ol class="space-y-[2.5mm]">
              {
                pasosGoogle.map((p) => (
                  <li class="flex items-start gap-[3mm] border-b border-gray-100 pb-[2.5mm] last:border-0 last:pb-0">
                    <span class="w-[6mm] h-[6mm] shrink-0 rounded-full bg-blue-600 text-white text-[9pt] font-black flex items-center justify-center">
                      {p.n}
                    </span>
                    <p class="text-[8.5pt] text-gray-800 leading-snug pt-[0.5mm]">
                      <b>{p.t}:</b>{" "}
                      <span class="text-gray-700">{p.d}</span>
                    </p>
                  </li>
                ))
              }
            </ol>

            <!-- Ejemplo -->
            <div class="mt-[4.5mm] border-l-[3px] border-blue-600 pl-[3.5mm] py-[1mm]">
              <p class="text-[7.5pt] font-extrabold tracking-[0.14em] uppercase text-blue-700">
                Piénselo así
              </p>
              <p class="text-[8.5pt] text-gray-700 leading-snug mt-[1mm] max-w-[175mm]">
                Dos mecánicos a cuatro cuadras uno del otro. El primero tiene
                40 opiniones buenas y fotos recientes; el segundo no aparece en
                el mapa. ¿A cuál le lleva su carro el recién llegado a la
                ciudad? La calidad puede ser igual — la diferencia es quien se
                hizo ver.
              </p>
            </div>
          </div>

          <!-- Pie -->
          <div class="mt-auto border-t-[3px] border-blue-600 pt-[4mm] flex items-end justify-between gap-4">
            <div>
              <p class="text-[15pt] font-black tracking-tight text-gray-900 leading-tight">
                Empecemos hoy: conversar no cuesta nada.
              </p>
              <p class="text-[8pt] text-gray-500 mt-[1.5mm]">
                Cada negocio es distinto: el alcance y el precio se acuerdan
                por escrito después de conocer su caso.
              </p>
            </div>
            <div class="flex flex-col gap-[1mm] shrink-0 text-right">
              <p class="text-[9.5pt] font-bold text-gray-900">
                📞 098 712 9357 <span class="font-normal text-gray-600">· WhatsApp</span>
              </p>
              <p class="text-[8pt] text-gray-700">✉️ christopher.villamarin@protonmail.com</p>
              <p class="text-[8pt] text-gray-700">🌐 xeland314.github.io · 👤 @xeland314</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @media print {
    @page {
      size: A4 portrait;
      margin: 0;
    }
    html,
    body {
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
    }
    main {
      min-height: auto !important;
    }
    .flyer-sheet,
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
