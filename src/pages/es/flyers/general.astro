---
// Volante A4 · Servicios digitales generales · Blanco imprimible
// En pantalla se ve como documento centrado con barra de herramientas;
// al imprimir (Ctrl+P) el chrome del sitio desaparece y queda la hoja exacta.
import BaseLayout from "../../../layouts/BaseLayout.astro";

const siteTitle = "Volante General · Servicios Digitales | Christopher Villamarín";
const siteDescription =
  "Servicios digitales para negocios locales en Quito: página web, negocio en el mapa de Google, opiniones con código QR, catálogos y automatizaciones.";
const siteKeywords =
  "volante, servicios digitales Quito, página web negocios, Google empresas, Christopher Villamarín";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/es/flyers/general";
const siteImage = "https://xeland314.github.io/images/preview-es.jpg";

const CURRENT = "general";

const navItems = [
  { slug: "general", label: "General", href: "/es/flyers/general" },
  { slug: "google", label: "Google", href: "/es/flyers/google" },
  { slug: "cotizacion", label: "Cotización", href: "/es/flyers/cotizacion" },
];

const servicios = [
  {
    icon: "🌐",
    titulo: "Página web para su negocio",
    texto:
      "Sus servicios, fotos reales y un botón para que le escriban directo por WhatsApp. Abre rápido en cualquier celular.",
  },
  {
    icon: "📍",
    titulo: "Su negocio en el mapa de Google",
    texto:
      "Lo registro oficialmente para que aparezca cuando alguien busca lo que usted vende. Nombre, horarios, fotos y ubicación siempre al día.",
  },
  {
    icon: "⭐",
    titulo: "Calificaciones de sus clientes",
    texto:
      "Cartelito con código QR para la caja o la vitrina: su cliente lo escanea y deja su opinión en segundos.",
  },
  {
    icon: "📱",
    titulo: "Programas para su celular",
    texto:
      "Catálogo, citas, pedidos o cuentas por cobrar, hechos a la medida de cómo trabaja usted. Funcionan incluso sin internet.",
  },
  {
    icon: "🔁",
    titulo: "Tareas que se hacen solas",
    texto:
      "Recordatorios de citas, avisos de cobros pendientes y control de lo que falta en bodega. Menos cuadernos, menos olvidos.",
  },
  {
    icon: "📄",
    titulo: "Menú o catálogo con código QR",
    texto:
      "Un código en cada mesa que abre su lista actual con precios y fotos. Lo actualiza usted mismo, sin reimprimir nada.",
  },
];

const pasos = [
  { n: "1", t: "Conversamos", d: "Me cuenta qué hace su negocio y qué necesita mostrar." },
  { n: "2", t: "Precio claro", d: "Cotización escrita, sin letra pequeña." },
  { n: "3", t: "Usted aprueba", d: "Ve avances reales y pide cambios antes de publicar." },
  { n: "4", t: "Le enseño", d: "Una sesión práctica para manejar todo usted mismo." },
];
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
  robots="noindex, nofollow"
>
  <main class="min-h-screen bg-gray-100 dark:bg-gray-950 py-8 px-4 print:!p-0 print:!bg-white">
    <!-- Barra de herramientas: SOLO pantalla -->
    <div class="flyer-toolbar max-w-[210mm] mx-auto mb-5 flex items-center justify-between gap-3 flex-wrap print:hidden">
      <div class="flex items-center gap-1 bg-white dark:bg-gray-800 rounded-full p-1 shadow-sm border border-gray-200 dark:border-gray-700">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "text-xs font-bold px-3 py-1.5 rounded-full transition-colors",
                CURRENT === item.slug
                  ? "bg-blue-600 text-white"
                  : "text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <button
        onclick="window.print()"
        class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 active:scale-95 text-white text-sm font-bold px-5 py-2 rounded-full shadow-lg shadow-blue-600/25 transition-all"
      >
        Imprimir · Guardar PDF
      </button>
    </div>

    <!-- Hoja A4 -->
    <div class="overflow-x-auto pb-10 print:overflow-visible print:pb-0">
      <div
        class="flyer-sheet w-[210mm] h-[297mm] mx-auto bg-white text-gray-900 shadow-xl shadow-gray-400/30 rounded-xl print:shadow-none print:rounded-none"
      >
        <div class="w-full h-full flex flex-col px-[14mm] pt-[9mm] pb-[7mm]">
          <!-- Cabecera -->
          <div class="flex items-center justify-between pb-[4mm] border-b border-gray-200">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
              <p class="text-[8pt] font-extrabold tracking-[0.14em] uppercase text-gray-800">
                Christopher Villamarín
              </p>
            </div>
            <p class="text-[9pt] font-extrabold text-gray-800">📞 098 712 9357</p>
          </div>

          <!-- Titular -->
          <div class="pt-[7mm]">
            <p class="text-[8pt] font-bold tracking-[0.18em] uppercase text-blue-700 mb-2">
              Servicios digitales · Quito, Ecuador
            </p>
            <h1 class="text-[23pt] font-black leading-[1.12] tracking-tight text-gray-900 max-w-[170mm]">
              Que nuevos clientes<br />lo encuentren en internet.
            </h1>
            <p class="mt-[3mm] text-[9.5pt] text-gray-600 leading-relaxed max-w-[168mm]">
              Ayudo a negocios locales a mostrarse en la red con lo que ya
              tienen: sus fotos, sus servicios y su forma de trabajar. Usted
              solo nota que más gente lo llama.
            </p>
          </div>

          <!-- Sección: servicios -->
          <div class="mt-[6mm]">
            <div class="flex items-center gap-3 mb-[3mm]">
              <h2 class="text-[11pt] font-black tracking-tight text-gray-900 whitespace-nowrap">
                ¿En qué le puedo ayudar?
              </h2>
              <span class="h-px flex-1 bg-gray-200"></span>
            </div>

            <div class="grid grid-cols-2 gap-x-[4mm] gap-y-[3mm]">
              {
                servicios.map((s) => (
                  <div class="border border-gray-200 rounded-xl p-[3mm] flex gap-[2.5mm] hover:border-blue-300 transition-colors">
                    <span class="w-[8mm] h-[8mm] shrink-0 rounded-lg border border-blue-100 bg-blue-50/60 flex items-center justify-center text-[11pt] leading-none">
                      {s.icon}
                    </span>
                    <div>
                      <p class="text-[9pt] font-bold text-gray-900 leading-tight">{s.titulo}</p>
                      <p class="text-[7.5pt] text-gray-600 leading-snug mt-[1mm]">{s.texto}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Dato clave -->
          <div class="mt-[5mm] border-l-[3px] border-blue-600 pl-[3.5mm] py-[1mm]">
            <p class="text-[7.5pt] font-extrabold tracking-[0.14em] uppercase text-blue-700">
              Un dato que casi nadie le cuenta
            </p>
            <p class="text-[8.5pt] text-gray-700 leading-snug mt-[1mm] max-w-[175mm]">
              Google <b>no</b> muestra su negocio solo por existir. Alguien
              tiene que registrarlo, confirmarlo y mantenerlo activo — como una
              vitrina limpia atrae miradas, un negocio bien presentado recibe
              llamadas. Ese es mi trabajo, y le enseño a cuidarlo.
            </p>
          </div>

          <!-- Proceso -->
          <div class="mt-[5mm]">
            <div class="flex items-center gap-3 mb-[3mm]">
              <h2 class="text-[11pt] font-black tracking-tight text-gray-900 whitespace-nowrap">
                Así de simple trabajamos
              </h2>
              <span class="h-px flex-1 bg-gray-200"></span>
            </div>
            <div class="grid grid-cols-4 gap-[3mm]">
              {
                pasos.map((p) => (
                  <div class="border border-gray-200 rounded-xl p-[2.5mm]">
                    <div class="flex items-center gap-[1.5mm]">
                      <span class="w-[5mm] h-[5mm] rounded-full bg-blue-600 text-white text-[8pt] font-black flex items-center justify-center">
                        {p.n}
                      </span>
                      <p class="text-[8.5pt] font-extrabold text-gray-900">{p.t}</p>
                    </div>
                    <p class="text-[7.5pt] text-gray-600 leading-snug mt-[1.5mm]">{p.d}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Pie -->
          <div class="mt-auto border-t-[3px] border-blue-600 pt-[4mm] flex items-end justify-between gap-4">
            <div>
              <p class="text-[15pt] font-black tracking-tight text-gray-900 leading-tight">
                Cotización en el momento, sin compromiso.
              </p>
              <p class="text-[8pt] text-gray-500 mt-[1.5mm]">
                El precio final depende de lo que su negocio necesite; se
                define juntos y por escrito antes de empezar.
              </p>
            </div>
            <div class="flex flex-col gap-[1mm] shrink-0 text-right">
              <p class="text-[9.5pt] font-bold text-gray-900">
                📞 098 712 9357 <span class="font-normal text-gray-600">· WhatsApp</span>
              </p>
              <p class="text-[8pt] text-gray-700">✉️ christopher.villamarin@protonmail.com</p>
              <p class="text-[8pt] text-gray-700">🌐 xeland314.github.io · 👤 @xeland314</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @media print {
    @page {
      size: A4 portrait;
      margin: 0;
    }
    html,
    body {
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
    }
    main {
      min-height: auto !important;
    }
    .flyer-sheet {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
