---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";

const title = "Catsplash - Portal Cautivo Wi-Fi para Linux";
const description =
  "Portal cautivo ligero escrito en Go para redes Wi-Fi temporales en Linux: bloqueo de tráfico con iptables, sesiones en SQLite, laboratorio de pruebas con network namespaces y cumplimiento documentado de la LOPDP.";
const keywords =
  "catsplash, portal cautivo, captive portal, go, golang, iptables, linux, hostapd, dnsmasq, sqlite, lopdp, protección de datos, network namespaces, testing";
const author = "Christopher Villamarín";
const applicationName = "Catsplash";
const url = "https://xeland314.github.io/es/projects/catsplash/";
const image = "/images/catsplash/admin_panel.jpg";
const imageAlt = "Panel de administración de Catsplash";
const robots = "index, follow";
const canonical = "https://xeland314.github.io/es/projects/catsplash/";

const features = [
  {
    title: "Portal Cautivo Compatible con CNA",
    desc: "Redirección HTTP al portal y compatibilidad con el Captive Network Assistant de Android e iOS para abrirlo automáticamente.",
  },
  {
    title: "Firewall Dinámico con iptables",
    desc: "Reglas inyectadas y limpiadas de forma atómica por cliente autenticado, sin dejar tráfico colgado al cerrar sesiones.",
  },
  {
    title: "Sesiones en SQLite",
    desc: "Gestión de clientes y sesiones con expiración por tiempo absoluto e inactividad, pensada para hardware de bajos recursos.",
  },
  {
    title: "CLI catsctl y Panel de Administración",
    desc: "Consulta de estado, listado de clientes y control de sesiones desde la terminal o el panel web protegido con contraseña.",
  },
];

const flows = [
  {
    tag: "Testing",
    color: "from-cyan-500 to-blue-600",
    title: "Laboratorio con Network Namespaces",
    points: [
      "Topología completa dentro del kernel: ns_router (AP + WAN), ns_wan (internet simulado) y hasta ns_client[1..100] con IP y MAC propias.",
      "Ráfagas de 100 clientes concurrentes: 100% de peticiones exitosas, pico de 13.6% CPU y menos de 24 MB RSS en un Core 2 Duo.",
      "Suite de pruebas automatizadas: soak tests multi-cliente, monitoreo de recursos y resultados versionados en CSV.",
    ],
  },
  {
    tag: "LOPDP",
    color: "from-emerald-500 to-teal-600",
    title: "Validación de Protección de Datos (Ecuador)",
    points: [
      "Consentimiento explícito antes de conectar: checkbox validado en backend con timestamp de aceptación.",
      "Derechos ARCO+ implementados: endpoints de acceso/portabilidad (/data-request) y eliminación (/data-deletion).",
      "DPIA, inventario y plan de retención documentados; auditoría de accesos y anonimización de MACs con SHA-256 truncado.",
    ],
  },
  {
    tag: "Redes Linux",
    color: "from-purple-500 to-indigo-600",
    title: "Manejo de Redes en Linux",
    points: [
      "Integración con hostapd (punto de acceso) y dnsmasq (DHCP/DNS) sobre interfaces Wi-Fi reales.",
      "Instalador guiado setup.sh que prepara dependencias, reglas de firewall y configuración del sistema en /opt/catsplash.",
      "Guías de red avanzada, seguridad Wi-Fi y resolución de problemas de conectividad incluidas en la documentación.",
    ],
  },
];
---

<ProjectLayout
  title={title}
  description={description}
  keywords={keywords}
  author={author}
  applicationName={applicationName}
  url={url}
  image={image}
  imageAlt={imageAlt}
  robots={robots}
  canonical={canonical}
  lang="es"
>
  <header class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl font-black mb-6 tracking-tighter">
      Cat<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-blue-600">splash</span>
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
      Portal cautivo minimalista en Go que bloquea el acceso a Internet hasta aceptar los términos y libera el tráfico de forma segura en redes Wi-Fi temporales.
    </p>
  </header>

  <div class="relative group mb-12">
    <img
      src="/images/catsplash/admin_panel.jpg"
      alt="Panel de administración de Catsplash con sesiones activas"
      class="rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800 w-full transform transition group-hover:scale-[1.01]"
    />
  </div>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-8">Características Principales</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        features.map((feature) => (
          <div class="group p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:border-cyan-500/30 transition-all duration-300 shadow-sm">
            <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
              {feature.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              {feature.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-4">Flujos Importantes del Proyecto</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-3xl">
      Tres pilares que llevaron el proyecto más allá del código: verificación experimental, cumplimiento legal y dominio de redes.
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {
        flows.map((flow) => (
          <div class="flex flex-col p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-lg transition-all duration-300">
            <span class={`inline-block self-start text-[10px] font-mono font-bold uppercase tracking-wider text-white px-2.5 py-1 rounded-md bg-gradient-to-r ${flow.color} mb-4`}>
              {flow.tag}
            </span>
            <h3 class="text-lg font-bold mb-4 text-gray-900 dark:text-white leading-snug">
              {flow.title}
            </h3>
            <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              {flow.points.map((point) => (
                <li class="flex gap-2">
                  <span class="text-cyan-500 mt-0.5">▸</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-12 grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="relative group">
      <img
        src="/images/catsplash/catsctl_example.jpg"
        alt="CLI catsctl mostrando estado y listado de clientes"
        class="rounded-2xl shadow-xl border border-gray-200 dark:border-gray-800 w-full transform transition group-hover:scale-[1.01]"
      />
      <p class="text-center text-xs text-gray-500 mt-3 font-mono uppercase tracking-wider">catsctl · CLI</p>
    </div>
    <div class="relative group">
      <img
        src="/images/catsplash/setup.sh.jpg"
        alt="Asistente de instalación setup.sh preparando hostapd, dnsmasq y firewall"
        class="rounded-2xl shadow-xl border border-gray-200 dark:border-gray-800 w-full transform transition group-hover:scale-[1.01]"
      />
      <p class="text-center text-xs text-gray-500 mt-3 font-mono uppercase tracking-wider">setup.sh · Instalador</p>
    </div>
  </section>

  <section class="mb-12 text-center p-12 rounded-3xl bg-gradient-to-br from-cyan-600/5 to-blue-500/5 border border-cyan-500/10">
    <h2 class="text-3xl font-bold mb-6">Documentación Completa</h2>
    <p class="mb-8 text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
      Guías de instalación, arquitectura, rendimiento y red, además del análisis de cumplimiento LOPDP, disponibles en el sitio de documentación y en el repositorio.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="https://xeland314.github.io/catsplash-docs/"
        target="_blank"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-bold transition-all transform hover:-translate-y-1 shadow-lg shadow-cyan-600/20"
      >
        Ver Documentación
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </a>
      <a
        href="https://github.com/xeland314/catsplash"
        target="_blank"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gray-800 hover:bg-gray-900 dark:bg-gray-700 dark:hover:bg-gray-600 text-white font-bold transition-all transform hover:-translate-y-1 shadow-lg"
      >
        Ver en GitHub
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
      </a>
    </div>
  </section>
</ProjectLayout>
