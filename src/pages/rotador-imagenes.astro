---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteTitle = "Rotador — Manipulador de rotación de imágenes";
const siteDescription = "Carga una imagen y aplica múltiples operaciones de rotación concatenadas. Perfecto para visualizar giros complejos.";
const siteKeywords = "rotación de imágenes, girar imagen, rotador, transformaciones CSS, ángulos";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/rotador";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <div 
    class="min-h-screen py-8 sm:py-10 px-4 sm:px-5 text-[#33393e] font-mono bg-[#eaf1f3]"
    style="background-image: linear-gradient(#d3e0e4 1px, transparent 1px), linear-gradient(90deg, #d3e0e4 1px, transparent 1px); background-size: 100% 32px, 32px 100%;"
  >
    <div class="max-w-[720px] mx-auto bg-white/55 border border-[#d3e0e4] rounded p-5 sm:p-8 sm:p-9 shadow-[0_1px_0_rgba(0,0,0,0.03)]">
      <p class="text-[11px] tracking-[0.16em] text-[#8b98a3] uppercase mb-1.5">Manipulador de imágenes · rotación</p>
      <h1 class="font-serif font-bold text-[28px] mb-1.5 text-[#33393e]">Rotador</h1>
      <p class="text-[#6b7680] font-serif text-[14.5px] leading-relaxed mb-[26px] max-w-[56ch]">
        Carga una imagen y aplica múltiples operaciones de rotación concatenadas. 
        Cada operación se aplica sobre el resultado anterior, permitiendo giros complejos como 900° + 770°.
      </p>

      <div class="mb-[22px]">
        <label class="block text-xs tracking-[0.06em] uppercase text-[#6b7680] mb-2">
          Imagen
        </label>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
          <input
            type="file"
            id="input-image"
            accept="image/*"
            class="flex-1 min-w-0 bg-white border border-[#d3e0e4] rounded-[3px] py-3 px-3.5 font-mono text-base tracking-[0.04em] text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          />
          <button
            id="btn-camera"
            class="font-serif font-bold text-sm bg-[#33393e] text-white border-0 py-3 px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#1f2428] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1 whitespace-nowrap"
          >
            Tomar foto
          </button>
        </div>
        <div id="image-preview-wrap" class="hidden mt-2">
          <img
            id="image-preview"
            alt="Vista previa de la imagen"
            class="max-h-[140px] max-w-full object-contain border border-[#d3e0e4] rounded-[3px] bg-white p-1"
          />
        </div>
      </div>

      <div class="mb-[22px]">
        <label class="block text-xs tracking-[0.06em] uppercase text-[#6b7680] mb-2">
          Operaciones de rotación
        </label>
        <div id="operations-list" class="flex flex-col gap-2 mb-3"></div>
        <div class="grid grid-cols-2 gap-2 items-end sm:flex sm:items-end">
          <div class="flex-1 min-w-0">
            <label for="rotation-degrees" class="block text-[11px] text-[#8b98a3] mb-1">Grados</label>
            <input
              type="number"
              id="rotation-degrees"
              min="0"
              max="3600"
              value="90"
              class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
            />
          </div>
          <div class="flex-1 min-w-0">
            <label for="rotation-direction" class="block text-[11px] text-[#8b98a3] mb-1">Dirección</label>
            <select
              id="rotation-direction"
              class="w-full bg-white border border-[#d3e0e4] rounded-[3px] py-2 px-3 font-mono text-sm text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
            >
              <option value="cw">Horario</option>
              <option value="ccw">Antihorario</option>
            </select>
          </div>
          <button
            id="btn-add-operation"
            class="col-span-2 sm:col-span-1 font-serif font-bold text-sm bg-[#33393e] text-white border-0 py-3 sm:py-[11px] px-[18px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#1f2428] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          >
            Agregar
          </button>
        </div>
      </div>

      <div class="mb-[22px] flex flex-col gap-2">
        <label class="flex items-center gap-2 text-sm text-[#33393e] cursor-pointer">
          <input
            type="checkbox"
            id="opt-trace"
            class="accent-[#c4392b] w-4 h-4"
          />
          <span>Trazar arco de rotaciones (goniómetro con vueltas)</span>
        </label>
        <label class="flex items-center gap-2 text-sm text-[#33393e] cursor-pointer">
          <input
            type="checkbox"
            id="opt-direct"
            class="accent-[#c4392b] w-4 h-4"
            checked
          />
          <span>Incluir resultado directo (ángulo efectivo) para contrastar</span>
        </label>
      </div>

      <div class="flex flex-col sm:flex-row gap-2 mb-[22px]">
        <button
          id="btn-apply"
          class="flex-1 font-serif font-bold text-sm bg-[#c4392b] text-white border-0 py-3 sm:py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#a32f23] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
        >
          Aplicar rotaciones
        </button>
        <button
          id="btn-export"
          class="flex-1 font-serif font-bold text-sm bg-[#33393e] text-white border-0 py-3 sm:py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#1f2428] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1 disabled:opacity-40 disabled:cursor-not-allowed"
          disabled
        >
          Exportar video
        </button>
        <button
          id="btn-clear"
          class="flex-1 font-serif font-bold text-sm bg-white text-[#6b7680] border border-[#d3e0e4] py-3 sm:py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#f5f7f8] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
        >
          Limpiar todo
        </button>
      </div>

      <div id="image-export-buttons" class="hidden flex flex-col sm:flex-row gap-2 mb-[22px]">
        <button
          id="btn-download-png"
          class="flex-1 font-serif font-bold text-sm bg-white text-[#33393e] border border-[#d3e0e4] py-3 sm:py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#f5f7f8] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
        >
          Descargar PNG
        </button>
        <button
          id="btn-export-zip"
          class="flex-1 font-serif font-bold text-sm bg-white text-[#33393e] border border-[#d3e0e4] py-3 sm:py-[11px] px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#f5f7f8] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
        >
          Exportar pasos (ZIP)
        </button>
      </div>

      <div id="export-progress" class="hidden mb-[22px]">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-[11px] tracking-[0.06em] uppercase text-[#6b7680]">Exportando video</span>
          <span id="export-progress-text" class="text-[11px] text-[#8b98a3] font-mono">0%</span>
        </div>
        <div class="w-full h-1.5 bg-[#e8edef] rounded-full overflow-hidden">
          <div id="export-progress-bar" class="h-full bg-[#c4392b] rounded-full transition-all duration-150" style="width: 0%"></div>
        </div>
      </div>

      <div id="resultado" class="mt-[30px]"></div>

      <canvas id="export-canvas" class="hidden"></canvas>
    </div>

    <div id="camera-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4 sm:p-6 bg-black/70">
      <div class="w-full max-w-[420px] bg-white border border-[#d3e0e4] rounded p-4 sm:p-5 shadow-xl">
        <div class="flex items-center justify-between mb-3">
          <span class="font-serif font-bold text-sm uppercase tracking-[0.06em] text-[#c4392b]">
            Tomar foto
          </span>
          <button
            id="btn-camera-close"
            class="font-serif text-lg text-[#6b7680] hover:text-[#33393e] cursor-pointer bg-transparent border-0 p-1 min-w-[36px] min-h-[36px] rounded-[3px]"
            title="Cerrar"
          >✕</button>
        </div>
        <div class="relative aspect-[3/4] bg-black rounded overflow-hidden">
          <video id="camera-video" autoplay playsinline muted class="absolute inset-0 w-full h-full object-cover"></video>
          <p id="camera-error" class="hidden absolute inset-0 flex items-center justify-center text-white font-serif text-sm px-6 text-center">
            No se pudo acceder a la cámara.
          </p>
        </div>
        <div class="flex gap-2 mt-3">
          <button
            id="btn-camera-capture"
            class="flex-1 font-serif font-bold text-sm bg-[#c4392b] text-white border-0 py-3 rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#a32f23] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1 min-h-[44px]"
          >
            Capturar
          </button>
          <button
            id="btn-camera-cancel"
            class="flex-1 font-serif font-bold text-sm bg-white text-[#6b7680] border border-[#d3e0e4] py-3 rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#f5f7f8] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1 min-h-[44px]"
          >
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { parseDirection, calculateTotalAngle, normalizeAngle, parseDegreesInput, buildAnimationSteps, formatFormula } from "../components/tools/rotador-imagenes/rotador";
    import type { RotationOperation, AnimationStep } from "../components/tools/rotador-imagenes/rotador";
    import { loadImage, exportVideo, exportStepAsPng, exportAllStepsAsZip, renderStepToCanvas } from "../components/tools/rotador-imagenes/canvas";

    let operations: RotationOperation[] = [];
    let imageDataUrl: string | null = null;
    let currentExport: { cancel: () => void } | null = null;
    let lastBuiltSteps: AnimationStep[] = [];
    let editingIndex: number | null = null;
    let showTrace = false;
    let includeDirectScene = true;

    function renderOperations() {
      const container = document.getElementById("operations-list");
      if (!container) return;
      if (operations.length === 0) {
        container.innerHTML = '<p class="text-[11.5px] text-[#8b98a3] font-serif italic">No hay operaciones. Agrega una arriba.</p>';
        return;
      }

      container.innerHTML = operations.map((op, i) => `
        <div class="flex items-center gap-1.5 sm:gap-2 py-2 px-2.5 bg-white border border-[#d3e0e4] rounded-[3px]">
          <span class="font-serif italic text-[#8b98a3] text-xs w-[18px] shrink-0">${i + 1}</span>
          <span class="text-sm text-[#33393e] flex-1 min-w-0">
            <span class="font-bold">${op.degrees}°</span> ${parseDirection(op.direction)}
          </span>
          <button 
            data-index="${i}" 
            class="btn-move-up font-serif text-sm text-[#8b98a3] hover:text-[#33393e] cursor-pointer bg-transparent border-0 p-2 sm:p-1 min-w-[36px] min-h-[36px] sm:min-w-0 sm:min-h-0 rounded-[3px]${i === 0 ? ' opacity-30 pointer-events-none' : ''}"
            title="Mover arriba"
          >▲</button>
          <button 
            data-index="${i}" 
            class="btn-move-down font-serif text-sm text-[#8b98a3] hover:text-[#33393e] cursor-pointer bg-transparent border-0 p-2 sm:p-1 min-w-[36px] min-h-[36px] sm:min-w-0 sm:min-h-0 rounded-[3px]${i === operations.length - 1 ? ' opacity-30 pointer-events-none' : ''}"
            title="Mover abajo"
          >▼</button>
          <button 
            data-index="${i}" 
            class="btn-edit-operation font-serif text-[13px] sm:text-[11px] text-[#6b7680] hover:text-[#33393e] cursor-pointer bg-transparent border-0 p-2 sm:p-1 min-w-[36px] min-h-[36px] sm:min-w-0 sm:min-h-0 rounded-[3px]"
            title="Editar"
          >✎</button>
          <button 
            data-index="${i}" 
            class="btn-remove-operation font-serif text-sm text-[#c4392b] hover:text-[#a32f23] cursor-pointer bg-transparent border-0 p-2 sm:p-1 min-w-[36px] min-h-[36px] sm:min-w-0 sm:min-h-0 rounded-[3px]"
          >
            ✕
          </button>
        </div>
      `).join("");

      container.querySelectorAll(".btn-move-up").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.target as HTMLElement).dataset.index!);
          if (idx > 0) {
            [operations[idx - 1], operations[idx]] = [operations[idx], operations[idx - 1]];
            renderOperations();
          }
        });
      });

      container.querySelectorAll(".btn-move-down").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.target as HTMLElement).dataset.index!);
          if (idx < operations.length - 1) {
            [operations[idx], operations[idx + 1]] = [operations[idx + 1], operations[idx]];
            renderOperations();
          }
        });
      });

      container.querySelectorAll(".btn-edit-operation").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.target as HTMLElement).dataset.index!);
          const op = operations[idx];
          const degreesInput = document.getElementById("rotation-degrees") as HTMLInputElement;
          const directionSelect = document.getElementById("rotation-direction") as HTMLSelectElement;
          degreesInput.value = String(op.degrees);
          directionSelect.value = op.direction;
          editingIndex = idx;
          const btnAdd = document.getElementById("btn-add-operation") as HTMLButtonElement;
          if (btnAdd) btnAdd.textContent = "Guardar";
        });
      });

      container.querySelectorAll(".btn-remove-operation").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.target as HTMLElement).dataset.index!);
          if (editingIndex === idx) {
            editingIndex = null;
            const btnAdd = document.getElementById("btn-add-operation") as HTMLButtonElement;
            if (btnAdd) btnAdd.textContent = "Agregar";
          } else if (editingIndex !== null && editingIndex > idx) {
            editingIndex--;
          }
          operations.splice(idx, 1);
          renderOperations();
        });
      });
    }

    function applyRotations() {
      const container = document.getElementById("resultado");
      if (!container) return;
      
      if (!imageDataUrl) {
        container.innerHTML = '<p class="text-[#8b98a3] font-serif text-sm">Carga una imagen primero.</p>';
        return;
      }

      if (operations.length === 0) {
        container.innerHTML = '<p class="text-[#8b98a3] font-serif text-sm">Agrega al menos una operación de rotación.</p>';
        return;
      }

      const totalAngle = calculateTotalAngle(operations);
      const normalizedAngle = normalizeAngle(totalAngle);
      const formula = formatFormula(operations);
      
      const allSteps = [{ label: "Original", angle: 0, operation: null }, ...operations.map((op, i) => ({
        label: `Paso ${i + 1}`,
        angle: calculateTotalAngle(operations.slice(0, i + 1)),
        operation: op,
      }))];

      const stepsGridHtml = allSteps.map((step, i) => {
        let formulaDetail = "";
        if (step.operation) {
          const cumulative = step.angle;
          const signed = step.operation.direction === "cw" ? step.operation.degrees : -step.operation.degrees;
          formulaDetail = `${signed >= 0 ? "+" : ""}${signed}° → acumulado: ${cumulative}°`;
        }
        return `
        <div class="bg-white border border-[#d3e0e4] rounded-[3px] p-3 flex flex-col">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-serif font-bold text-[11px] text-[#c4392b] uppercase tracking-[0.06em]">${step.label}</span>
            ${step.operation ? `<span class="text-[10px] text-[#8b98a3] font-mono">${step.operation.degrees}° ${parseDirection(step.operation.direction)}</span>` : ''}
          </div>
          <div class="flex-1 flex items-center justify-center p-2 bg-[#f8fafb] border border-[#e8edef] rounded-[2px] min-h-[120px]">
            <img 
              src="${imageDataUrl}" 
              alt="${step.label}" 
              class="max-w-full max-h-[150px] object-contain transition-transform duration-300"
              style="transform: rotate(${step.angle}deg);"
            />
          </div>
          <div class="mt-2 text-center">
            ${formulaDetail
              ? `<span class="font-mono text-[10px] text-[#8b98a3] block">${formulaDetail}</span>`
              : ''}
            <span class="font-mono text-[11px] text-[#6b7680]">${step.angle}°</span>
          </div>
        </div>
      `}).join("");

      container.innerHTML = `
        <div class="border-t border-dashed border-[#d3e0e4] pt-5 mt-1.5">
          <div class="flex items-baseline gap-2.5 mb-2">
            <span class="text-[#c4392b] font-serif font-bold text-[13px] uppercase tracking-[0.08em]">Resultado</span>
            <span class="text-[#33393e] font-serif text-sm">
              Rotación total: <span class="font-bold">${totalAngle}°</span>
              ${normalizedAngle !== totalAngle ? `(${normalizedAngle}° efectivos)` : ''}
            </span>
          </div>
          <div class="mb-4 p-3 bg-[#f8fafb] border border-[#e8edef] rounded-[3px]">
            <span class="text-[10px] tracking-[0.04em] uppercase text-[#8b98a3] font-mono block mb-1">Cálculo</span>
            <code class="font-mono text-[13px] text-[#33393e]">${formula}</code>
          </div>
          
          <div class="grid grid-cols-1 min-[420px]:grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-4">
            ${stepsGridHtml}
          </div>

          <div id="trace-preview" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4${showTrace ? "" : " hidden"}"></div>
        </div>
      `;

      if (showTrace && imageDataUrl) {
        renderTracePreview(totalAngle, normalizedAngle);
      }
    }

    async function renderTracePreview(totalAngle: number, normalizedAngle: number) {
      const holder = document.getElementById("trace-preview");
      if (!holder || !imageDataUrl) return;
      try {
        const img = await loadImage(imageDataUrl);
        const size = Math.max(img.naturalWidth, img.naturalHeight, 720);
        const commonOpts = { canvasWidth: size, canvasHeight: size, bgColor: "#ffffff", trace: true, showTurns: true };

        const cumulativeStep: AnimationStep = {
          fromAngle: totalAngle,
          toAngle: totalAngle,
          duration: 0,
          label: "Acumulado",
          traceMode: "cumulative",
        };
        const directStep: AnimationStep = {
          fromAngle: normalizedAngle,
          toAngle: normalizedAngle,
          duration: 0,
          label: "Directo (efectivo)",
          traceMode: "direct",
        };

        const cumCanvas = renderStepToCanvas(img, cumulativeStep, commonOpts);
        cumCanvas.className = "w-full max-w-[360px] mx-auto bg-white border border-[#d3e0e4] rounded-[3px]";
        const directCanvas = renderStepToCanvas(img, directStep, commonOpts);
        directCanvas.className = "w-full max-w-[360px] mx-auto bg-white border border-[#d3e0e4] rounded-[3px]";

        holder.innerHTML = "";
        const cumCard = document.createElement("div");
        cumCard.className = "flex flex-col gap-2";
        cumCard.innerHTML = '<span class="font-serif font-bold text-[11px] text-[#c4392b] uppercase tracking-[0.06em]">Procedimiento acumulado</span>';
        cumCard.appendChild(cumCanvas);

        const directCard = document.createElement("div");
        directCard.className = "flex flex-col gap-2";
        directCard.innerHTML = '<span class="font-serif font-bold text-[11px] text-[#c4392b] uppercase tracking-[0.06em]">Procedimiento directo (efectivo)</span>';
        directCard.appendChild(directCanvas);

        holder.appendChild(cumCard);
        if (includeDirectScene) holder.appendChild(directCard);
      } catch (err) {
        console.error("Error renderizando vista previa con trazado:", err);
      }
    }

    document.getElementById("opt-trace")?.addEventListener("change", async (e) => {
      showTrace = (e.target as HTMLInputElement).checked;
      const btnExport = document.getElementById("btn-export") as HTMLButtonElement;
      if (imageDataUrl && operations.length > 0 && !btnExport?.disabled) {
        lastBuiltSteps = buildAnimationSteps(operations, undefined, includeDirectScene);
        applyRotations();
      }
    });

    document.getElementById("opt-direct")?.addEventListener("change", async (e) => {
      includeDirectScene = (e.target as HTMLInputElement).checked;
      const btnExport = document.getElementById("btn-export") as HTMLButtonElement;
      if (imageDataUrl && operations.length > 0 && !btnExport?.disabled) {
        lastBuiltSteps = buildAnimationSteps(operations, undefined, includeDirectScene);
        applyRotations();
      }
    });

    let cameraStream: MediaStream | null = null;

    function setImage(dataUrl: string) {
      imageDataUrl = dataUrl;
      const preview = document.getElementById("image-preview") as HTMLImageElement;
      const previewWrap = document.getElementById("image-preview-wrap");
      if (preview) preview.src = dataUrl;
      if (previewWrap) previewWrap.classList.remove("hidden");
      const resultado = document.getElementById("resultado");
      if (resultado) {
        resultado.innerHTML =
          '<p class="text-[#6b7680] font-serif text-sm">Imagen cargada. Agrega operaciones y haz clic en "Aplicar rotaciones".</p>';
      }
    }

    function openCamera() {
      const modal = document.getElementById("camera-modal");
      const errorEl = document.getElementById("camera-error");
      if (!modal || !navigator.mediaDevices?.getUserMedia) {
        alert("La cámara no está disponible en este navegador. Usa la selección de archivos.");
        return;
      }
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      if (errorEl) errorEl.classList.add("hidden");

      navigator.mediaDevices
        .getUserMedia({ video: { facingMode: "environment", width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false })
        .then((stream) => {
          cameraStream = stream;
          const video = document.getElementById("camera-video") as HTMLVideoElement;
          video.srcObject = stream;
          video.play().catch(() => {});
        })
        .catch((err) => {
          console.error("Error accediendo a la cámara:", err);
          if (errorEl) errorEl.classList.remove("hidden");
        });
    }

    function closeCamera() {
      if (cameraStream) {
        cameraStream.getTracks().forEach((track) => track.stop());
        cameraStream = null;
      }
      const video = document.getElementById("camera-video") as HTMLVideoElement;
      if (video.srcObject) {
        (video.srcObject as MediaStream).getTracks().forEach((t) => t.stop());
        video.srcObject = null;
      }
      const modal = document.getElementById("camera-modal");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    }

    function capturePhoto() {
      const video = document.getElementById("camera-video") as HTMLVideoElement;
      if (!video || video.videoWidth === 0) return;
      const canvas = document.createElement("canvas");
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      const dataUrl = canvas.toDataURL("image/jpeg", 0.92);
      setImage(dataUrl);
      closeCamera();
    }

    document.getElementById("btn-camera")?.addEventListener("click", openCamera);
    document.getElementById("btn-camera-capture")?.addEventListener("click", capturePhoto);
    document.getElementById("btn-camera-cancel")?.addEventListener("click", closeCamera);
    document.getElementById("btn-camera-close")?.addEventListener("click", closeCamera);

    document.getElementById("input-image")?.addEventListener("change", (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          setImage(event.target?.result as string);
        };
        reader.readAsDataURL(file);
      }
    });

    document.getElementById("btn-add-operation")?.addEventListener("click", () => {
      const degreesInput = document.getElementById("rotation-degrees") as HTMLInputElement;
      const directionSelect = document.getElementById("rotation-direction") as HTMLSelectElement;
      const degrees = parseDegreesInput(degreesInput.value);
      const direction = directionSelect.value as "cw" | "ccw";
      
      if (degrees === null) {
        alert("Ingresa un número de grados válido (0 o mayor).");
        return;
      }

      if (editingIndex !== null) {
        operations[editingIndex] = { degrees, direction };
        editingIndex = null;
        const btnAdd = document.getElementById("btn-add-operation") as HTMLButtonElement;
        if (btnAdd) btnAdd.textContent = "Agregar";
      } else {
        operations.push({ degrees, direction });
      }
      renderOperations();
    });

    document.getElementById("btn-apply")?.addEventListener("click", () => {
      applyRotations();
      const btnExport = document.getElementById("btn-export") as HTMLButtonElement;
      const imageExportButtons = document.getElementById("image-export-buttons");
      const canExport = !!imageDataUrl && operations.length > 0;
      if (btnExport) btnExport.disabled = !canExport;
      if (imageExportButtons) {
        imageExportButtons.classList.toggle("hidden", !canExport);
      }
      if (canExport) {
        lastBuiltSteps = buildAnimationSteps(operations, undefined, includeDirectScene);
      }
    });

    document.getElementById("btn-export")?.addEventListener("click", async () => {
      if (!imageDataUrl || operations.length === 0) return;
      if (currentExport) {
        currentExport.cancel();
        currentExport = null;
        return;
      }

      const btnExport = document.getElementById("btn-export") as HTMLButtonElement;
      const progressContainer = document.getElementById("export-progress");
      const progressText = document.getElementById("export-progress-text");
      const progressBar = document.getElementById("export-progress-bar");

      btnExport.textContent = "Cancelar";
      progressContainer?.classList.remove("hidden");

      const img = await loadImage(imageDataUrl);
      const canvas = document.getElementById("export-canvas") as HTMLCanvasElement;

      const size = Math.max(img.naturalWidth, img.naturalHeight, 720);
      const { promise, cancel } = exportVideo(
        canvas,
        img,
        lastBuiltSteps,
        { canvasWidth: size, canvasHeight: size, fps: 30, bgColor: "#ffffff", trace: showTrace, showTurns: true },
        (p) => {
          if (progressText) progressText.textContent = `${p}%`;
          if (progressBar) progressBar.style.width = `${p}%`;
        },
      );

      currentExport = { cancel };

      await promise;
      currentExport = null;
      btnExport.textContent = "Exportar video";
      progressContainer?.classList.add("hidden");
      if (progressText) progressText.textContent = "0%";
      if (progressBar) progressBar.style.width = "0%";
    });

    document.getElementById("btn-download-png")?.addEventListener("click", async () => {
      if (!imageDataUrl || lastBuiltSteps.length === 0) return;
      const img = await loadImage(imageDataUrl);
      const finalStep =
        lastBuiltSteps.find((s) => s.label === "Resultado final") ??
        lastBuiltSteps[lastBuiltSteps.length - 1];
      const size = Math.max(img.naturalWidth, img.naturalHeight, 720);
      await exportStepAsPng(img, finalStep, { canvasWidth: size, canvasHeight: size, bgColor: "#ffffff", trace: showTrace, showTurns: true });
    });

    document.getElementById("btn-export-zip")?.addEventListener("click", async () => {
      if (!imageDataUrl || lastBuiltSteps.length === 0) return;
      const btnZip = document.getElementById("btn-export-zip") as HTMLButtonElement;
      btnZip.disabled = true;
      btnZip.textContent = "Generando...";

      const img = await loadImage(imageDataUrl);
      const size = Math.max(img.naturalWidth, img.naturalHeight, 720);
      await exportAllStepsAsZip(img, lastBuiltSteps, { canvasWidth: size, canvasHeight: size, bgColor: "#ffffff", trace: showTrace, showTurns: true });

      btnZip.disabled = false;
      btnZip.textContent = "Exportar pasos (ZIP)";
    });

    document.getElementById("btn-clear")?.addEventListener("click", () => {
      if (currentExport) {
        currentExport.cancel();
        currentExport = null;
      }
      operations = [];
      imageDataUrl = null;
      lastBuiltSteps = [];
      editingIndex = null;
      closeCamera();
      const inputImage = document.getElementById("input-image") as HTMLInputElement;
      if (inputImage) inputImage.value = "";
      const preview = document.getElementById("image-preview") as HTMLImageElement;
      if (preview) preview.removeAttribute("src");
      const previewWrap = document.getElementById("image-preview-wrap");
      if (previewWrap) previewWrap.classList.add("hidden");
      const btnAdd = document.getElementById("btn-add-operation") as HTMLButtonElement;
      if (btnAdd) btnAdd.textContent = "Agregar";
      renderOperations();
      const resultado = document.getElementById("resultado");
      if (resultado) resultado.innerHTML = "";
      const btnExport = document.getElementById("btn-export") as HTMLButtonElement;
      if (btnExport) btnExport.disabled = true;
      const imageExportButtons = document.getElementById("image-export-buttons");
      if (imageExportButtons) imageExportButtons.classList.add("hidden");
      const progressContainer = document.getElementById("export-progress");
      if (progressContainer) progressContainer.classList.add("hidden");
    });

    renderOperations();
  </script>
</BaseLayout>