              <tfoot class="bg-gray-50 dark:bg-gray-800 font-bold">
                <tr>
                  <td colspan="3" class="p-3 text-right">TOTAL CÁMARAS</td>
                  <td class="p-3 text-right" id="t-subtotal">$0.00</td>
                  <td class="p-3 text-right" id="t-base">$0.00</td>
                  <td class="p-3 text-right" id="t-iva">$0.00</td>
                  <td class="print:hidden"></td>
                </tr>
                <tr>
                  <td colspan="3" class="p-3 text-right">Accesorios (SD, cables, instalación)</td>
                  <td class="p-3 text-right" id="t-acc-sub">$0.00</td>
                  <td class="p-3 text-right" id="t-acc-base">$0.00</td>
                  <td class="p-3 text-right" id="t-acc-iva">$0.00</td>
                  <td class="print:hidden"></td>
