                </tr>
                <tr class="bg-gray-50/50 dark:bg-gray-800/20">
                  <td class="p-3 font-semibold">Casa Trasera - 1er piso</td>
                  <td class="p-3 text-center">2</td>
                  <td class="p-3 text-center">1</td>
                  <td class="p-3 text-center font-bold">3</td>
                  <td class="p-3 text-xs text-gray-600">2 interior (salas) + 1 exterior (patio/acceso)</td>
