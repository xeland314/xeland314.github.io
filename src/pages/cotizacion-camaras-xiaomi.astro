  <script is:inline>
    const IVA = 0.15;
    const defaultRows = [
      { nombre: "Xiaomi C300 Interior PTZ 360º - Sukasa (9 interior)", precio: 42.29, cant: 9, tipo: "cam" },
      { nombre: "Xiaomi C500 Pro Exterior - Sukasa (3 exterior)", precio: 62.99, cant: 3, tipo: "cam" },
