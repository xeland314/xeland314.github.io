            <label class="flex items-center gap-2 text-sm font-bold cursor-pointer print:hidden">
              <input id="incluye-iva" type="checkbox" checked class="w-4 h-4 accent-blue-600" />
              Precios incluyen IVA
            </label>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400">Presets ajustados a la distribución real 9+3. Edita cantidades/precios si cambias de proveedor.</p>

