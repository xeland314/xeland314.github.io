                  <td class="p-3"><span class="font-semibold">Mi Camera 2K Magnetic Mount</span><br/><span class="text-xs text-gray-500">Fija magnética · 2K · IR · audio 2 vías</span></td>
                  <td class="p-3 text-right font-black">$45.00<br/><span class="text-xs font-normal text-emerald-700">$39.00 efectivo</span></td>
