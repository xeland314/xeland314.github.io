    function fmt(n){ return "$" + n.toFixed(2); }
    function addRow(data){
      const tr = document.createElement("tr");
      tr.className = "bg-white dark:bg-gray-900";
      tr.dataset.tipo = data.tipo || "cam";
      tr.innerHTML = `
        <td class="p-2"><input class="w-full bg-transparent border-b border-gray-200 dark:border-gray-700 focus:border-blue-500 outline-none px-1 py-1" value="${data.nombre}"></td>
        <td class="p-2 text-center"><input type="number" min="0" step="1" class="w-16 text-center border border-gray-300 dark:border-gray-700 rounded-lg px-1 py-1 bg-white dark:bg-gray-800" value="${data.cant}"></td>
        <td class="p-2 text-right"><input type="number" min="0" step="0.01" class="w-24 text-right border border-gray-300 dark:border-gray-700 rounded-lg px-1 py-1 bg-white dark:bg-gray-800" value="${data.precio.toFixed(2)}"></td>
        <td class="p-2 text-right font-bold subtotal">$0.00</td>
        <td class="p-2 text-right text-gray-600 base">$0.00</td>
        <td class="p-2 text-right text-gray-600 iva">$0.00</td>
        <td class="p-2 text-center print:hidden"><button class="text-red-500 hover:text-red-700 font-bold px-2">×</button></td>
      `;
      const cantInput = tr.querySelectorAll('input[type="number"]')[0];
      const precioInput = tr.querySelectorAll('input[type="number"]')[1];
      tr.querySelector("button").addEventListener("click", () => { tr.remove(); recalc(); });
      cantInput.addEventListener("input", recalc);
      precioInput.addEventListener("input", recalc);
      tbody.appendChild(tr);
    }
    function recalc(){
      const incluyeIVA = elIncluyeIVA.checked;
      let camSub=0, camBase=0, camIva=0, accSub=0, accBase=0, accIva=0;
      [...tbody.children].forEach(tr => {
        const cant = parseFloat(tr.querySelectorAll('input[type="number"]')[0].value) || 0;
        const precio = parseFloat(tr.querySelectorAll('input[type="number"]')[1].value) || 0;
        const subtotal = cant * precio;
        let base, iva;
        if (incluyeIVA){ base = subtotal / (1+IVA); iva = subtotal - base; } else { base = subtotal; iva = base * IVA; }
        const totalMostrar = incluyeIVA ? subtotal : base + iva;
        tr.querySelector(".subtotal").textContent = fmt(totalMostrar);
        tr.querySelector(".base").textContent = fmt(base);
        tr.querySelector(".iva").textContent = fmt(iva);
        if (tr.dataset.tipo === "cam"){ camSub += totalMostrar; camBase += base; camIva += iva; } else { accSub += totalMostrar; accBase += base; accIva += iva; }
      });
      document.getElementById("t-subtotal").textContent = fmt(camSub);
      document.getElementById("t-base").textContent = fmt(camBase);
      document.getElementById("t-iva").textContent = fmt(camIva);
      document.getElementById("t-acc-sub").textContent = fmt(accSub);
      document.getElementById("t-acc-base").textContent = fmt(accBase);
      document.getElementById("t-acc-iva").textContent = fmt(accIva);
      document.getElementById("t-grand").textContent = fmt(camSub+accSub);
      document.getElementById("t-grand-base").textContent = fmt(camBase+accBase);
      document.getElementById("t-grand-iva").textContent = fmt(camIva+accIva);
    }
    function loadPreset(kind){
      tbody.innerHTML = "";
      if (kind === "reco"){
        addRow({ nombre: "Xiaomi C300 Interior PTZ - Sukasa (9 interior)", precio: 42.29, cant: 9, tipo: "cam" });
        addRow({ nombre: "Xiaomi C500 Pro Exterior - Sukasa (3 exterior)", precio: 62.99, cant: 3, tipo: "cam" });
        addRow({ nombre: "microSD 128GB Endurance", precio: 12.00, cant: 12, tipo: "acc" });
        addRow({ nombre: "Kit cable 3m + canaleta", precio: 4.50, cant: 12, tipo: "acc" });
      } else if (kind === "eco"){
        addRow({ nombre: "Xiaomi 2K Magnetic Mount - GadgetStore $39 (9 interior)", precio: 39.00, cant: 9, tipo: "cam" });
        addRow({ nombre: "Xiaomi C500 Pro Exterior - Sukasa (3 exterior)", precio: 62.99, cant: 3, tipo: "cam" });
        addRow({ nombre: "microSD 128GB Endurance", precio: 12.00, cant: 12, tipo: "acc" });
        addRow({ nombre: "Kit cable 3m + canaleta", precio: 4.50, cant: 12, tipo: "acc" });
      } else if (kind === "12suk"){
        addRow({ nombre: "Xiaomi C300/C500 mix Sukasa (12 total)", precio: 42.29, cant: 12, tipo: "cam" });
        addRow({ nombre: "microSD 128GB Endurance", precio: 12.00, cant: 12, tipo: "acc" });
        addRow({ nombre: "Kit cable 3m + canaleta", precio: 4.50, cant: 12, tipo: "acc" });
      }
      recalc();
    }
    defaultRows.forEach(addRow);
    elIncluyeIVA.addEventListener("change", recalc);
    document.getElementById("btn-add-row").addEventListener("click", () => { addRow({ nombre: "Nuevo concepto", precio: 0, cant: 1, tipo: "acc" }); recalc(); });
    document.getElementById("btn-preset-real-reco").addEventListener("click", () => loadPreset("reco"));
    document.getElementById("btn-preset-real-eco").addEventListener("click", () => loadPreset("eco"));
    document.getElementById("btn-preset-12sukasa").addEventListener("click", () => loadPreset("12suk"));
    document.getElementById("btn-clear").addEventListener("click", () => { tbody.innerHTML=""; recalc(); });
    const now = new Date();
    const fmtDate = now.toLocaleDateString("es-EC", { year:"numeric", month:"long", day:"numeric"});
    document.getElementById("fecha-hoy").textContent = fmtDate;
    const el2 = document.getElementById("fecha-hoy-2"); if(el2) el2.textContent = fmtDate;
    document.getElementById("fecha-iva").textContent = fmtDate;
    recalc();
  </script>
</BaseLayout>
