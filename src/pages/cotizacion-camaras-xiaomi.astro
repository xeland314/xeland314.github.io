                </tr>
                <tr>
                  <td class="p-3 font-semibold">Vicsan (oficina)</td>
                  <td class="p-3 text-center">1</td>
                  <td class="p-3 text-center">0</td>
                  <td class="p-3 text-center font-bold">1</td>
                  <td class="p-3 text-xs text-gray-600">1 interior</td>
                </tr>
                <tr class="bg-gray-50/50 dark:bg-gray-800/20">
                  <td class="p-3 font-semibold">Vicsan - 4to piso (pasillo)</td>
                  <td class="p-3 text-center">1</td>
                  <td class="p-3 text-center">0</td>
                  <td class="p-3 text-center font-bold">1</td>
