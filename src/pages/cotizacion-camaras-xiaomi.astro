---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Cotización Cámaras Xiaomi - 12 unidades (9 interior + 3 exterior) | Informe y Calculadora";
const description = "Cotización distribuida por sedes: Hostal, Casa Trasera, Vicsan, GGM. 9 cámaras interior + 3 exterior Xiaomi con IVA 15% Ecuador. Compara GadgetStore, Sukasa y Ganacell con calculadora imprimible.";
const keywords = "Xiaomi, camara vigilancia, cotizacion, C300, C500 Pro, Hostal, Casa Trasera, Vicsan, GGM, IVA Ecuador";
const author = "Christopher Villamarín - xeland314";
const url = "https://xeland314.github.io/cotizacion-camaras-xiaomi";
const image = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout title={title} description={description} keywords={keywords} author={author} url={url} image={image} canonical={url}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-950 print:bg-white">
    <div class="max-w-5xl mx-auto py-6 px-4 sm:px-6 print:max-w-none print:p-0">
      <div class="mb-6 flex items-center justify-between print:hidden">
        <a href="/" class="text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-2 font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Volver al inicio
        </a>
        <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold shadow flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
          Imprimir / Guardar PDF
