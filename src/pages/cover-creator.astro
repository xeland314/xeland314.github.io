---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CoverCreator } from "../components/tools/covers/CoverCreator";


const title = "Crea Portadas para tus Posts | Herramienta de Cover Creator";
const description = "Diseña portadas personalizadas para tus artículos con esta herramienta fácil de usar, perfecta para destacar tu contenido en redes sociales y blogs.";
const keywords = "Cover Creator, Portadas para Posts, Diseño de Portadas, Herramienta de Diseño, Herramienta para Bloggers, Christopher Villamarín";
const author = "Christopher Alexander Villamarín Pila";
const url = "https://xeland314.github.io/code-to-img";
const image = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout showHeader={false} 
  title={title} 
  description={description}
  keywords={keywords}
  author={author}
  url={url}
  image={image}
  canonical={url}
>
  <main class="min-h-screen lg:h-screen lg:overflow-hidden bg-gray-50 dark:bg-gray-950">
    <div class="h-full max-w-[110rem] mx-auto py-4 px-4 sm:px-6 flex flex-col">
      <header class="mb-3 flex-shrink-0 flex flex-wrap items-center gap-x-5 gap-y-1">
        <a href="/" class="text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-2 font-bold transition-all hover:-translate-x-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Inicio
        </a>
        <h1 class="text-2xl font-black text-gray-900 dark:text-white tracking-tighter">
          Cover Creator
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 hidden md:block">↑↓ navegar · Espacio avanzar · Ctrl+D duplicar · Supr eliminar · doble clic en slider = ×1</p>
      </header>

      <div class="flex-1 min-h-0">
        <CoverCreator client:only="react" />
      </div>

    </div>
  </main>
</BaseLayout>
