---
import BaseLayout from "../layouts/BaseLayout.astro";
import PdfCropper from "../components/tools/pdf-crop/PdfCropper";

const siteTitle = "Recortar PDF — Selecciona páginas, borra y recorta sin subir nada";
const siteDescription =
  "Herramienta offline para recortar PDFs: selecciona páginas por intervalos (1, 3-5), borra páginas, extrae solo las que necesitas y recorta visualmente cada página como una imagen. Todo en tu navegador, sin subir archivos. Con deshacer Ctrl+Z.";
const siteKeywords =
  "recortar pdf, cortar pdf, borrar páginas pdf, extraer páginas pdf, pdf offline, crop pdf, intervalos páginas";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/recortar-pdf";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
const siteAppName = "Recortar PDF";
---

<BaseLayout
  showHeader={false}
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
  applicationName={siteAppName}
>
  <div class="min-h-screen py-8 sm:py-12 px-4 flex flex-col items-center bg-gray-50 dark:bg-gray-950 transition-colors duration-300">
    <div class="w-full max-w-6xl">
      <div class="mb-6 text-center sm:text-left">
        <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-mono tracking-widest uppercase mb-4">
          Herramienta offline · 100% en tu navegador
        </p>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-gray-900 dark:text-white mb-3">Recortar PDF</h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed max-w-3xl">
          Selecciona páginas por intervalos, borra lo que no necesitas, extrae solo un rango y <b>recorta cada página arrastrando</b> como si fuera una imagen. <span class="font-semibold text-gray-900 dark:text-white">Nada se sube</span> — todo en tu dispositivo. <kbd class="px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-800 border text-xs font-mono">Ctrl+Z</kbd> deshacer.
        </p>
      </div>
      <PdfCropper client:only="react" />
      <div class="mt-8 p-4 rounded-2xl bg-gray-900 dark:bg-black border border-gray-800 text-xs leading-relaxed text-gray-400 max-w-6xl mx-auto">
        <span class="font-bold text-white">Privado y offline:</span> el PDF nunca sale de tu navegador. Puedes usar esta página sin internet después de la primera carga. Si cierras la pestaña, el archivo se restaura desde IndexedDB — descarga el resultado antes.
      </div>
    </div>
  </div>
</BaseLayout>
