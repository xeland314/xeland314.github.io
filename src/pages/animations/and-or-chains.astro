---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import ChainsDiagram from "../../components/animations/and-or-chains/ChainsDiagram.astro";
import ConsoleOut from "../../components/animations/and-or-chains/ConsoleOut.astro";
import ControlsChains from "../../components/animations/and-or-chains/ControlsChains.astro";

const siteTitle = "Bash · && vs || (Exit Codes)";
const siteDescription =
  "Animación del cortocircuito en Bash: && avanza solo cuando el exit code es 0 y || actúa cuando es distinto de 0, con una cadena ping → echo → echo.";
const siteKeywords =
  "bash, shell, exit codes, cortocircuito, short circuit, and, or, encadenamiento, ping, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/and-or-chains";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="BASH · EXIT CODES">
      <Fragment slot="title">
        &amp;&amp; y ||: el exit code<br />
        decide si la cadena <span class="text-[#facc15]">sigue</span>
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <CodePanel file="chain.sh">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-ch-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <ChainsDiagram />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsChains />
  </main>
</BaseLayout>

<script>
  import { initChainAnimation } from "../../components/animations/and-or-chains/controller";
  initChainAnimation();
</script>
