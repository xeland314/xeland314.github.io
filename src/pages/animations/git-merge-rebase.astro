---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import GitGraph from "../../components/animations/git-merge-rebase/GitGraph.astro";
import ConsoleOut from "../../components/animations/git-merge-rebase/ConsoleOut.astro";
import ControlsGit from "../../components/animations/git-merge-rebase/ControlsGit.astro";

const siteTitle = "Git · Merge vs Rebase (Árboles de Commits)";
const siteDescription =
  "Animación narrada de Git: cómo un merge crea un commit de fusión y preserva la ramificación, mientras que un rebase reescribe el historial de forma lineal sin commit de fusión.";
const siteKeywords =
  "git, merge, rebase, control de versiones, historial lineal, commit de fusión, ramas, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/git-merge-rebase";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="GIT · CONTROL DE VERSIONES">
      <Fragment slot="title">
        Diferencia entre<br />
        <span class="text-[#a855f7]">Merge</span> vs <span class="text-[#f05032]"
          >Rebase</span
        >
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-4 px-6 pb-8">
        <CodePanel file="git_merge.sh">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-git-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <GitGraph />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsGit />
  </main>
</BaseLayout>

<script>
  import { initGitAnimation } from "../../components/animations/git-merge-rebase/controller";
  initGitAnimation();
</script>