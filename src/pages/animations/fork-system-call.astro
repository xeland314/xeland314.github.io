---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import ForkDiagram from "../../components/animations/fork-system-call/ForkDiagram.astro";
import ConsoleOut from "../../components/animations/fork-system-call/ConsoleOut.astro";
import ControlsFork from "../../components/animations/fork-system-call/ControlsFork.astro";

const siteTitle = "Linux · fork() — una llamada, dos procesos";
const siteDescription =
  "Animación de fork() en C: el kernel duplica al proceso llamador, el hijo recibe 0 y el padre recibe el pid del hijo; ambos reanudan en la misma línea del programa.";
const siteKeywords =
  "fork, sistema operativo, procesos linux, pid, proceso hijo, unistd.h, getpid, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/fork-system-call";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="LINUX · PROCESOS">
      <Fragment slot="title">
        fork(): una llamada,<br />
        <span class="text-[#3fd0e0]">dos</span> procesos
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <CodePanel file="fork_demo.c">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-fk-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <ForkDiagram />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsFork />
  </main>
</BaseLayout>

<script>
  import { initForkAnimation } from "../../components/animations/fork-system-call/controller";
  initForkAnimation();
</script>
