---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import LinkDiagram from "../../components/animations/symlink-hardlink/LinkDiagram.astro";
import ConsoleOut from "../../components/animations/symlink-hardlink/ConsoleOut.astro";
import ControlsLinks from "../../components/animations/symlink-hardlink/ControlsLinks.astro";

const siteTitle = "Linux · Symlink vs Hard Link (Inodos)";
const siteDescription =
  "Animación de inodos en Linux: el hard link apunta directo al inodo y sobrevive al rm, mientras el symlink guarda una ruta que se rompe cuando el nombre original desaparece.";
const siteKeywords =
  "symlink, hard link, inodo, inode, ln, rm, filesystem linux, nlink, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/symlink-vs-hardlink";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="LINUX · FILESYSTEM">
      <Fragment slot="title">
        Symlink guarda una <span class="text-[#3fd0e0]">ruta</span>,<br />
        hard link apunta al <span class="text-[#7cfb4c]">inodo</span>
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <CodePanel file="links.sh">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-lnk-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <LinkDiagram />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsLinks />
  </main>
</BaseLayout>

<script>
  import { initLinkAnimation } from "../../components/animations/symlink-hardlink/controller";
  initLinkAnimation();
</script>
