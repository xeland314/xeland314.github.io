---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import ContextBox from "../../components/animations/python-with/ContextBox.astro";
import ConsoleOut from "../../components/animations/python-with/ConsoleOut.astro";
import ControlsWith from "../../components/animations/python-with/ControlsWith.astro";

const siteTitle = "Python · Context Managers (with statement)";
const siteDescription =
  "Animación narrada del statement with de Python: el context manager abre el recurso en __enter__, ejecuta el bloque y lo cierra garantizado en __exit__, incluso ante excepciones.";
const siteKeywords =
  "python, with, context manager, __enter__, __exit__, gestión de recursos, base de datos, excepciones, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/with-in-python";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="PYTHON · GESTIÓN DE RECURSOS">
      <Fragment slot="title">
        Garantiza recursos con<br />
        <span class="text-[#7CFB4C]">with</span> (Context Manager)
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-4 px-6 pb-8">
        <CodePanel file="conexion_db.py">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-with-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <ContextBox />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsWith />
  </main>
</BaseLayout>

<script>
  import { initWithAnimation } from "../../components/animations/python-with/controller";
  initWithAnimation();
</script>