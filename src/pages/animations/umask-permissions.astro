---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import UmaskDiagram from "../../components/animations/umask-permissions/UmaskDiagram.astro";
import ConsoleOut from "../../components/animations/umask-permissions/ConsoleOut.astro";
import ControlsUmask from "../../components/animations/umask-permissions/ControlsUmask.astro";

const siteTitle = "Linux · umask y Permisos Binarios";
const siteDescription =
  "Animación de umask en Linux: cómo la máscara 022 o 077 resta bits con una operación AND NOT sobre los permisos por defecto (666 para archivos, 777 para directorios) bit a bit.";
const siteKeywords =
  "umask, permisos linux, chmod, rwx, and not, máscara binaria, 644, 755, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/umask-permissions";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="LINUX · PERMISOS">
      <Fragment slot="title">
        umask: la máscara que<br />
        <span class="text-[#ff5f57]">quita</span> bits antes de crear
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <CodePanel file="umask.sh">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-um-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <UmaskDiagram />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsUmask />
  </main>
</BaseLayout>

<script>
  import { initUmaskAnimation } from "../../components/animations/umask-permissions/controller";
  initUmaskAnimation();
</script>
