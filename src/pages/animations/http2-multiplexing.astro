---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import MuxDiagram from "../../components/animations/http2-multiplexing/MuxDiagram.astro";
import ConsoleOut from "../../components/animations/http2-multiplexing/ConsoleOut.astro";
import ControlsHttp2 from "../../components/animations/http2-multiplexing/ControlsHttp2.astro";

const siteTitle = "HTTP/2 · Multiplexación de Streams (Frames)";
const siteDescription =
  "Animación de HTTP/2: cómo el Binary Framing Layer intercala frames HEADERS y DATA de múltiples streams en una sola conexión TCP, eliminando el head-of-line blocking de HTTP/1.1.";
const siteKeywords =
  "http2, multiplexación, binary framing, streams, frames, tcp, head-of-line blocking, hpack, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/http2-multiplexing";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="HTTP/2 · RFC 7540 / 9113">
      <Fragment slot="title">
        De texto plano a<br />
        <span class="text-[#38bdf8]">frames binarios</span> multiplexados
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <MuxDiagram />
        <CodePanel file="http_1_1.txt">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-h2-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsHttp2 />
  </main>
</BaseLayout>

<script>
  import { initHttp2Animation } from "../../components/animations/http2-multiplexing/controller";
  initHttp2Animation();
</script>
