---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import ChmodDiagram from "../../components/animations/chmod-binary/ChmodDiagram.astro";
import ConsoleOut from "../../components/animations/chmod-binary/ConsoleOut.astro";
import ControlsChmod from "../../components/animations/chmod-binary/ControlsChmod.astro";

const siteTitle = "Linux · chmod Bit a Bit";
const siteDescription =
  "Animación de chmod en Linux: cómo el modo numérico 755 enciende los bits de ejecución de rw-r--r-- a rwxr-xr-x, grupo por grupo (dueño, grupo y otros).";
const siteKeywords =
  "chmod, permisos linux, 644, 755, rwx, bits, binario, octal, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/chmod-binary";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="LINUX · PERMISOS">
      <Fragment slot="title">
        chmod: el modo numérico<br />
        <span class="text-[#facc15]">bit a bit</span> hasta rwxr-xr-x
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <CodePanel file="script.sh">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-cb-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <ChmodDiagram />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsChmod />
  </main>
</BaseLayout>

<script>
  import { initChmodAnimation } from "../../components/animations/chmod-binary/controller";
  initChmodAnimation();
</script>
