---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import HpackDiagram from "../../components/animations/http2-hpack/HpackDiagram.astro";
import ConsoleOut from "../../components/animations/http2-hpack/ConsoleOut.astro";
import ControlsHpack from "../../components/animations/http2-hpack/ControlsHpack.astro";

const siteTitle = "HTTP/2 · HPACK (Compresión de Headers)";
const siteDescription =
  "Animación de HPACK en HTTP/2: tabla estática de 61 entradas, tabla dinámica compartida por sesión y codificación Huffman para eliminar la redundancia de cabeceras entre peticiones.";
const siteKeywords =
  "http2, hpack, compresión headers, tabla estática, tabla dinámica, huffman, rfc 7541, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/http2-hpack";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="HTTP/2 · RFC 7541">
      <Fragment slot="title">
        HPACK: deja de reenviar<br />
        las <span class="text-[#a855f7]">mismas cabeceras</span>
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <HpackDiagram />
        <CodePanel file="hpack_flow.txt">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-hp-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsHpack />
  </main>
</BaseLayout>

<script>
  import { initHpackAnimation } from "../../components/animations/http2-hpack/controller";
  initHpackAnimation();
</script>
