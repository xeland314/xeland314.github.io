---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import FdDiagram from "../../components/animations/file-descriptors/FdDiagram.astro";
import ConsoleOut from "../../components/animations/file-descriptors/ConsoleOut.astro";
import ControlsFd from "../../components/animations/file-descriptors/ControlsFd.astro";

const siteTitle = "Linux · Descriptores de Archivo (stdin, stdout, stderr)";
const siteDescription =
  "Animación de file descriptors en Linux: cómo la shell reconecta los fds 0, 1 y 2 al usar > (trunca), >> (añade al final) y 2>&1 (duplica stderr hacia stdout) antes de ejecutar el programa.";
const siteKeywords =
  "file descriptors, stdin, stdout, stderr, redirección, bash, shell linux, 2>&1, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/fds-redirection";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="LINUX · SHELL">
      <Fragment slot="title">
        <span class="text-[#7cfb4c]">&gt;</span>
        <span class="text-[#fdba74]">&gt;&gt;</span> y
        <span class="text-[#3fd0e0]">2&gt;&amp;1</span>:<br />
        reconectando tuberías
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-3 px-6 pb-8">
        <CodePanel file="fds.sh">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-fd-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <FdDiagram />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsFd />
  </main>
</BaseLayout>

<script>
  import { initFdAnimation } from "../../components/animations/file-descriptors/controller";
  initFdAnimation();
</script>
