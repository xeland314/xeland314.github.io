---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ANIMATIONS } from "../../components/bentos/animations-data";

const siteTitle = "Animaciones de Código | Christopher Villamarín";
const siteDescription =
  "Colección de animaciones de programación y sistemas: Go, Python, Git, HTTP/2, redes TCP/UDP y Linux (señales, inodos, file descriptors, umask). Cada una muestra el flujo paso a paso con exportación a video vertical.";
const siteKeywords =
  "go, python, animaciones, programación, buffered channel, defer, decoradores, generadores, match, with, contexto";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <main class="min-h-screen bg-[#060a0f] text-gray-200 py-12 px-4 sm:px-8">
    <div class="max-w-6xl mx-auto">
      <header class="mb-14">
        <a
          href="/"
          class="text-blue-400 hover:underline mb-6 inline-flex items-center gap-2 font-bold transition-all hover:-translate-x-1"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-left"
            ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg
          >
          Volver al inicio
        </a>
        <h1
          class="text-4xl md:text-6xl font-black text-white mb-6 tracking-tighter"
        >
          Animaciones de{" "}
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400"
            >Código</span
          >
        </h1>
        <p class="text-xl text-gray-400 max-w-3xl leading-relaxed">
          Conceptos de <span class="text-cyan-400 font-bold">Go</span>,{" "}
          <span class="text-emerald-400 font-bold">Python</span>,{" "}
          <span class="text-purple-400 font-bold">Git</span>,{" "}
          <span class="text-sky-400 font-bold">HTTP/2</span> y{" "}
          <span class="text-orange-400 font-bold">Linux</span> explicados con
          animaciones narradas. Cada una muestra el flujo de ejecución paso a
          paso, con exportación a video vertical para redes sociales.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          ANIMATIONS.map((anim, idx) => (
            <a
              href={`/animations/${anim.slug}`}
              aria-label={`${anim.title.es} — ${anim.description.es}`}
              class="group relative flex flex-col gap-4 p-6 rounded-3xl border border-white/10 bg-white/[0.03] hover:border-white/25 hover:bg-white/[0.06] transition-all duration-300 hover:-translate-y-1 overflow-hidden"
            >
              <span
                class="absolute top-4 right-5 font-mono text-xs text-white/20 font-bold"
                aria-hidden="true"
              >
                {String(idx + 1).padStart(2, "0")}
              </span>

              <div
                aria-hidden="true"
                class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${anim.gradient} flex items-center justify-center shadow-lg`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <Fragment set:html={anim.icon} />
                </svg>
              </div>

              <div class="flex-1">
                <h2
                  class="text-lg font-black text-white group-hover:text-cyan-300 transition-colors tracking-tight"
                >
                  {anim.title.es}
                </h2>
                <p class="mt-2 text-sm text-gray-400 leading-relaxed">
                  {anim.description.es}
                </p>
              </div>

              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold text-white/40 uppercase tracking-wider bg-white/5 border border-white/10 px-2 py-0.5 rounded">
                  {anim.badge.es}
                </span>
                <span
                  class="text-xs font-bold text-cyan-300 opacity-0 group-hover:opacity-100 transition-opacity"
                >
                  Ver animación →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>