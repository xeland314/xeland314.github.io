---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stage from "../../components/animations/Stage.astro";
import CodePanel from "../../components/animations/code/CodePanel.astro";
import DecoratorBox from "../../components/animations/python-decorator/DecoratorBox.astro";
import ConsoleOut from "../../components/animations/python-decorator/ConsoleOut.astro";
import ControlsDecorator from "../../components/animations/python-decorator/ControlsDecorator.astro";

const siteTitle = "Python · Patrón Decorador (@decorador)";
const siteDescription =
  "Animación narrada del patrón decorador en Python: cómo @medir_tiempo envuelve una función para ejecutar código ANTES y DESPUÉS de ella.";
const siteKeywords =
  "python, decorador, decorator, wrapper, patrón de diseño, @medir_tiempo, animación, video";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/animations/python-decorator";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </Fragment>

  <main class="min-h-screen flex flex-col items-center justify-center gap-5 py-10 px-4 bg-[#060a0f]">
    <Stage eyebrow="PYTHON · PATRONES DE DISEÑO">
      <Fragment slot="title">
        Así funciona un<br />
        <span class="text-[#3fd0e0]">@decorador</span>
      </Fragment>
      <div class="flex-1 min-h-0 flex flex-col justify-center gap-4 px-6 pb-8">
        <CodePanel file="decoradores.py">
          <Fragment slot="badge">
            <span id="statusBadge" class="anim-dec-badge">ESPERANDO</span>
          </Fragment>
        </CodePanel>
        <DecoratorBox />
        <ConsoleOut />
      </div>
    </Stage>

    <ControlsDecorator />
  </main>
</BaseLayout>

<script>
  import { initDecoratorAnimation } from "../../components/animations/python-decorator/controller";
  initDecoratorAnimation();
</script>