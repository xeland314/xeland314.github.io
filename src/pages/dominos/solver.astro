---
import BaseLayout from "../../layouts/BaseLayout.astro";

const siteTitle = "Dominós — Solver de secuencias";
const siteDescription =
  "Resuelve secuencias de dominó en notación dXX. Parseo, aritmética módulo 7 y estrategias heurísticas ordenadas por prioridad.";
const siteKeywords =
  "dominó, solver, secuencia, patrón, módulo 7, notación dXX, razonamiento";
const siteAuthor = "Christopher Alexander Villamarín Pila";
const siteUrl = "https://xeland314.github.io/dominos/solver";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";

const examples = [
  { label: "d01d12d23", hint: "Desplazamiento constante (+1)" },
  { label: "d12d03d64", hint: "A decrece, B avanza" },
  { label: "d01d23d45", hint: "Serpiente / Zig-Zag" },
  { label: "d11d12d23d35", hint: "Fibonacci (aditiva)" },
  { label: "d00d11d22d00d11d22", hint: "Bloque periódico (p=3)" },
  { label: "d00d11d11d22", hint: "Alternado (Δ +1, 0)" },
];
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  author={siteAuthor}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
>
  <div
    class="min-h-screen py-8 sm:py-10 px-4 sm:px-5 text-[#33393e] font-mono bg-[#eaf1f3]"
    style="background-image: linear-gradient(#d3e0e4 1px, transparent 1px), linear-gradient(90deg, #d3e0e4 1px, transparent 1px); background-size: 100% 32px, 32px 100%;"
  >
    <div
      class="max-w-[720px] mx-auto bg-white/55 border border-[#d3e0e4] rounded p-5 sm:p-8 sm:p-9 shadow-[0_1px_0_rgba(0,0,0,0.03)]"
    >
      <a
        href="/dominos/"
        class="text-xs text-[#c4392b] hover:underline mb-4 inline-block"
        >← Volver al visualizador</a
      >

      <p class="text-[11px] tracking-[0.16em] text-[#8b98a3] uppercase mb-1.5">
        Juegos de mesa · dominó · solver
      </p>
      <h1 class="font-serif font-bold text-[28px] mb-1.5 text-[#33393e]">
        Solver de secuencias
      </h1>
      <p
        class="text-[#6b7680] font-serif text-[14.5px] leading-relaxed mb-[26px] max-w-[56ch]"
      >
        Ingresa una secuencia de fichas en notación
        <code class="font-mono text-[#c4392b]">dXX</code> y el solver aplica
        estrategias heurísticas sobre aritmética módulo 7 para predecir la
        siguiente ficha. Cada valor va de 0 a 6, donde 6 + 1 = 0 y 0 − 1 = 6.
      </p>

      <div class="mb-[22px]">
        <label for="seq-input" class="block text-xs tracking-[0.06em] uppercase text-[#6b7680] mb-2">
          Secuencia (notación dXX)
        </label>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
          <input
            type="text"
            id="seq-input"
            value="d01d12d23"
            placeholder="ej: d01d12d23"
            spellcheck="false"
            class="flex-1 min-w-0 bg-white border border-[#d3e0e4] rounded-[3px] py-3 px-3.5 font-mono text-base tracking-[0.04em] text-[#33393e] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1"
          />
          <button
            id="btn-solve"
            class="font-serif font-bold text-sm bg-[#c4392b] text-white border-0 py-3 px-[22px] rounded-[3px] cursor-pointer tracking-[0.02em] hover:bg-[#a32f23] focus:outline-2 focus:outline-[#c4392b] focus:outline-offset-1 whitespace-nowrap"
          >
            Resolver
          </button>
        </div>

        <div class="mt-3 flex flex-wrap gap-1.5">
          {examples.map((ex) => (
            <button
              class="example-btn font-mono text-[10.5px] bg-white border border-[#d3e0e4] rounded-[3px] px-2.5 py-1.5 text-[#6b7680] cursor-pointer hover:text-[#33393e] hover:border-[#6b7680] transition-all"
              data-example={ex.label}
              title={ex.hint}
            >
              {ex.label}
            </button>
          ))}
        </div>
      </div>

      <div id="resultado" class="mt-[30px]"></div>
    </div>
  </div>

  <script>
    import {
      parseDominoes,
      solveDominoSequence,
      listMatches,
    } from "../../components/tools/dominos/solver";
    import { createTile } from "../../components/tools/dominos/core";
    import { renderTileSVG, tileLabel } from "../../components/tools/dominos/svg";

    function tileToHtml(top: number, bottom: number, highlighted = false) {
      const tile = createTile(top as any, bottom as any, "vertical", "medium");
      const svg = renderTileSVG(tile);
      const label = tileLabel(tile);
      const borderClass = highlighted
        ? "border-[#c4392b] ring-2 ring-[#c4392b]/20"
        : "border-[#d3e0e4]";
      return `
        <div class="flex flex-col items-center gap-1 bg-white border ${borderClass} rounded-[3px] p-2">
          ${svg}
          <span class="text-[10px] text-[#8b98a3] font-mono">${label}</span>
        </div>
      `;
    }

    function render() {
      const container = document.getElementById("resultado");
      if (!container) return;

      const input = document.getElementById("seq-input") as HTMLInputElement;
      const raw = input.value.trim();
      const dominoes = parseDominoes(raw);

      if (dominoes.length === 0) {
        container.innerHTML = `
          <div class="border-t border-dashed border-[#d3e0e4] pt-5 mt-1.5">
            <p class="text-[#8b98a3] font-serif text-sm">
              No se encontraron fichas válidas. Usa la notación
              <code class="font-mono text-[#c4392b]">dXX</code>, por ejemplo
              <code class="font-mono">d01d12d23</code>.
            </p>
          </div>
        `;
        return;
      }

      const prediction = solveDominoSequence(raw);
      const matches = listMatches(raw);

      const tilesHtml = dominoes.map((d) => tileToHtml(d[0], d[1])).join("");

      const predictionHtml = prediction
        ? `
          <div class="bg-[#f8fafb] border border-[#e8edef] rounded-[3px] p-4 mb-4">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-3">
              <span class="text-[10px] tracking-[0.04em] uppercase text-[#8b98a3] font-mono">Siguiente ficha</span>
              <span class="font-mono text-[13px] text-[#c4392b] font-bold">${prediction.formatted}</span>
              <span class="font-serif text-[11px] text-[#6b7680]">${prediction.strategyName}</span>
              <span class="text-[10px] text-[#8b98a3] font-mono">confianza ${Math.round(prediction.confidence * 100)}%</span>
            </div>
            <div class="flex flex-col items-center gap-2">
              ${tileToHtml(prediction.nextDomino[0], prediction.nextDomino[1], true)}
            </div>
            <div class="mt-3 w-full h-1.5 bg-[#e8edef] rounded-full overflow-hidden">
              <div class="h-full bg-[#c4392b] rounded-full" style="width: ${Math.round(prediction.confidence * 100)}%"></div>
            </div>
          </div>
        `
        : `
          <div class="bg-[#f8fafb] border border-[#e8edef] rounded-[3px] p-4 mb-4">
            <p class="text-[#8b98a3] font-serif text-sm">
              No se pudo predecir la siguiente ficha con las estrategias disponibles.
              Prueba con más fichas o un patrón más claro.
            </p>
          </div>
        `;

      const allStrategiesHtml =
        matches.length > 1
          ? `
          <div class="mb-4">
            <span class="text-[10px] tracking-[0.04em] uppercase text-[#8b98a3] font-mono block mb-2">Hipótesis detectadas</span>
            <div class="flex flex-col gap-1.5">
              ${matches
                .map(
                  (m) => `
                <div class="flex items-center gap-2 justify-between bg-white border border-[#d3e0e4] rounded-[3px] px-3 py-2 text-[12px]">
                  <span class="font-mono text-[#33393e]">${m.formatted}</span>
                  <span class="font-serif text-[11px] text-[#6b7680] flex-1 text-left pl-2">${m.strategyName}</span>
                  <span class="text-[10px] text-[#8b98a3] font-mono shrink-0">${Math.round(m.confidence * 100)}%</span>
                </div>
              `,
                )
                .join("")}
            </div>
          </div>
        `
          : "";

      container.innerHTML = `
        <div class="border-t border-dashed border-[#d3e0e4] pt-5 mt-1.5">
          <div class="flex items-baseline gap-2.5 mb-3">
            <span class="text-[#c4392b] font-serif font-bold text-[13px] uppercase tracking-[0.08em]">Resultado</span>
            <span class="text-[#33393e] font-serif text-sm">
              <span class="font-bold">${dominoes.length}</span> fichas detectadas
            </span>
          </div>

          <div class="mb-4">
            <span class="text-[10px] tracking-[0.04em] uppercase text-[#8b98a3] font-mono block mb-2">Secuencia ingresada</span>
            <div class="flex flex-wrap gap-2 bg-[#f8fafb] border border-[#e8edef] rounded-[3px] p-3 items-center justify-center">
              ${tilesHtml}
            </div>
          </div>

          ${predictionHtml}
          ${allStrategiesHtml}

          <div class="bg-[#f8fafb] border border-[#e8edef] rounded-[3px] p-3 mb-4">
            <span class="text-[10px] tracking-[0.04em] uppercase text-[#8b98a3] font-mono block mb-1">Cálculo</span>
            <code class="font-mono text-[13px] text-[#33393e] break-all">${raw}</code>
          </div>
        </div>
      `;
    }

    document.getElementById("btn-solve")?.addEventListener("click", render);

    document.getElementById("seq-input")?.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter") render();
    });

    document.querySelectorAll(".example-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const input = document.getElementById("seq-input") as HTMLInputElement;
        input.value = (btn as HTMLElement).dataset.example!;
        render();
      });
    });

    render();
  </script>
</BaseLayout>
