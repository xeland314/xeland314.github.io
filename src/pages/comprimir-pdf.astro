---
import BaseLayout from "../layouts/BaseLayout.astro";
import PdfCompressor from "../components/tools/pdf-compress/PdfCompressor";

const siteTitle = "Comprimir PDF — Reduce peso hoja por hoja sin subir nada";
const siteDescription = "Herramienta offline para comprimir PDFs y ZIPs con PDFs: 4 niveles, vista previa hoja por hoja sin miniaturas, raster JPEG + gris. Todo en tu navegador.";
const siteKeywords = "comprimir pdf, reducir pdf, pdf zip, comprimir zip pdf, pdf offline";
const siteUrl = "https://xeland314.github.io/comprimir-pdf";
const siteImage = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  showHeader={false}
  title={siteTitle}
  description={siteDescription}
  keywords={siteKeywords}
  url={siteUrl}
  image={siteImage}
  canonical={siteUrl}
  applicationName="Comprimir PDF"
>
  <div class="min-h-screen py-8 sm:py-12 px-4 flex flex-col items-center bg-gray-50 dark:bg-gray-950 transition-colors duration-300">
    <div class="w-full max-w-6xl">
      <div class="mb-6 text-center sm:text-left">
        <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-violet-500/30 bg-violet-500/10 text-violet-600 dark:text-violet-400 text-xs font-mono tracking-widest uppercase mb-4">Herramienta offline · 100% en tu navegador · PDF o ZIP</p>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-gray-900 dark:text-white mb-3">Comprimir PDF</h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed max-w-3xl">Sube un <b>PDF</b> o un <b>ZIP con varios PDFs</b>. Elige nivel (baja/media/alta/extrema), <b>previsualiza hoja por hoja</b> cómo se comprimirá — <b>sin miniaturas</b> — y descarga el resultado (PDF o ZIP). Nada se sube.</p>
      </div>
      <PdfCompressor client:only="react" />
      <div class="mt-8 p-4 rounded-2xl bg-gray-900 dark:bg-black border border-gray-800 text-xs leading-relaxed text-gray-400 max-w-6xl mx-auto">
        <span class="font-bold text-white">Privado:</span> todo se procesa en tu dispositivo. Soporta ZIP con múltiples PDFs (se comprimen uno a uno y se re-empaquetan).
      </div>
    </div>
  </div>
</BaseLayout>
