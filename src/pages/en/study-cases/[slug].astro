---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { STUDY_CASES } from "../../../components/study-cases/study-cases-data";

export function getStaticPaths() {
  return STUDY_CASES.map((studyCase) => ({
    params: { slug: studyCase.slug },
    props: { studyCase },
  }));
}

const { studyCase } = Astro.props;
const lang = "en";

const pageTitle = `${studyCase.client} - Case Study | Christopher Villamarín`;
const pageDescription = studyCase.summary.en;
const pageKeywords =
  "case study, web development, local seo, quito, local business";
const pageAuthor = "Christopher Villamarín";
const pageUrl = `https://xeland314.github.io/en/study-cases/${studyCase.slug}/`;
const pageImage = `https://xeland314.github.io${studyCase.heroImage?.src ?? "/assets/images/logo_v3.png"}`;
const pageCanonical = pageUrl;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  author={pageAuthor}
  url={pageUrl}
  image={pageImage}
  canonical={pageCanonical}
  lang={lang}
>
  <main
    class="py-8 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white min-h-screen"
  >
    <article class="max-w-4xl mx-auto px-6">
      <a
        href="/en/study-cases"
        class="text-blue-600 dark:text-blue-400 hover:underline block mb-8"
      >
        ← Back to case studies
      </a>

      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-white px-2.5 py-1 rounded-md bg-gradient-to-r from-cyan-500 to-blue-600">
            {studyCase.year}
          </span>
          <span class="text-xs font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400">
            {studyCase.role.en}
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl font-black mb-4 tracking-tighter">
          {studyCase.client}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl">
          {studyCase.summary.en}
        </p>
      </header>

      {
        studyCase.heroImage && (
          <figure class="mb-10">
            <Image
              src={studyCase.heroImage.src}
              width={studyCase.heroImage.width}
              height={studyCase.heroImage.height}
              alt={studyCase.heroImage.alt[lang]}
              class="w-full rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          </figure>
        )
      }

      <section class="mb-8 p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-3">
          The business
        </h2>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          {studyCase.context.en}
        </p>
      </section>

      <section class="mb-8 p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-3">
          The problem
        </h2>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          {studyCase.problem.en}
        </p>
      </section>

      <section class="mb-8 p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-5">
          What I did
        </h2>
        <ul class="space-y-4" role="list">
          {
            studyCase.work.en.map((point) => (
              <li class="flex gap-3 text-gray-700 dark:text-gray-300 leading-relaxed">
                <svg
                  class="w-5 h-5 mt-0.5 shrink-0 text-emerald-500"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        studyCase.evidence && (
          <section class="mb-8 p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
            <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-3">
              Results
            </h2>
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
              {studyCase.resultsIntro?.en}
            </p>
            <div class="grid gap-6 sm:grid-cols-2">
              {studyCase.evidence.map((item) => (
                <figure class="m-0">
                  <Image
                    src={item.src}
                    width={item.width}
                    height={item.height}
                    alt={item.alt[lang]}
                    class="w-full rounded-xl border border-gray-200 dark:border-gray-700"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-snug">
                    {item.caption[lang]}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <section class="mb-8 p-8 rounded-2xl bg-gradient-to-br from-cyan-600/5 to-blue-500/5 border border-cyan-500/10">
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-3">
          Current state
        </h2>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
          {studyCase.note.en}
        </p>
        <a
          href={studyCase.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-bold transition-all transform hover:-translate-y-0.5 shadow-lg shadow-cyan-600/20"
        >
          View live site
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7" /><path d="M7 7h10v10" />
          </svg>
        </a>
      </section>
    </article>
  </main>
</BaseLayout>
