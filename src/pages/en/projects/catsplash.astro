---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";

const title = "Catsplash - Wi-Fi Captive Portal for Linux";
const description =
  "Lightweight captive portal written in Go for temporary Linux Wi-Fi networks: traffic blocking with iptables, SQLite sessions, a network-namespaces testing lab, and documented Ecuadorian LOPDP data-protection compliance.";
const keywords =
  "catsplash, captive portal, go, golang, iptables, linux, hostapd, dnsmasq, sqlite, data protection, network namespaces, testing";
const author = "Christopher Villamarín";
const applicationName = "Catsplash";
const url = "https://xeland314.github.io/en/projects/catsplash/";
const image = "/images/catsplash/admin_panel.jpg";
const imageAlt = "Catsplash administration panel";
const robots = "index, follow";
const canonical = "https://xeland314.github.io/en/projects/catsplash/";

const features = [
  {
    title: "CNA-Compatible Captive Portal",
    desc: "HTTP redirection to the portal with support for the Android and iOS Captive Network Assistant so it opens automatically.",
  },
  {
    title: "Dynamic iptables Firewall",
    desc: "Rules injected and cleaned atomically per authenticated client, never leaving dangling traffic after sessions close.",
  },
  {
    title: "SQLite-Backed Sessions",
    desc: "Client and session management with absolute-time and inactivity expiration, designed for low-resource hardware.",
  },
  {
    title: "catsctl CLI & Admin Panel",
    desc: "Status queries, client listing and session control from the terminal or the password-protected web panel.",
  },
];

const flows = [
  {
    tag: "Testing",
    color: "from-cyan-500 to-blue-600",
    title: "Network Namespaces Lab",
    points: [
      "Full topology inside the kernel: ns_router (AP + WAN), ns_wan (simulated internet) and up to ns_client[1..100] each with its own IP and MAC.",
      "Bursts of 100 concurrent clients: 100% successful requests, 13.6% peak CPU and under 24 MB RSS on a Core 2 Duo.",
      "Automated test suite: multi-client soak tests, resource monitoring and CSV results kept in version control.",
    ],
  },
  {
    tag: "Data Protection",
    color: "from-emerald-500 to-teal-600",
    title: "LOPDP Compliance (Ecuador)",
    points: [
      "Explicit consent before connecting: backend-validated checkbox with acceptance timestamp.",
      "ARCO+ rights implemented: access/portability (/data-request) and deletion (/data-deletion) endpoints.",
      "Documented DPIA, data inventory and retention plan; access audit trail and truncated SHA-256 MAC anonymization.",
    ],
  },
  {
    tag: "Linux Networking",
    color: "from-purple-500 to-indigo-600",
    title: "Linux Network Handling",
    points: [
      "Integration with hostapd (access point) and dnsmasq (DHCP/DNS) on real Wi-Fi interfaces.",
      "Guided setup.sh installer that prepares dependencies, firewall rules and system configuration under /opt/catsplash.",
      "Advanced networking, Wi-Fi security and connectivity troubleshooting guides included in the docs.",
    ],
  },
];
---

<ProjectLayout
  title={title}
  description={description}
  keywords={keywords}
  author={author}
  applicationName={applicationName}
  url={url}
  image={image}
  imageAlt={imageAlt}
  robots={robots}
  canonical={canonical}
  lang="en"
>
  <header class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl font-black mb-6 tracking-tighter">
      Cat<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-blue-600">splash</span>
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
      A minimalist Go captive portal that blocks Internet access until terms are accepted, then releases traffic safely on temporary Wi-Fi networks.
    </p>
  </header>

  <div class="relative group mb-12">
    <img
      src="/images/catsplash/admin_panel.jpg"
      alt="Catsplash admin panel showing active sessions"
      class="rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800 w-full transform transition group-hover:scale-[1.01]"
    />
  </div>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-8">Key Features</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        features.map((feature) => (
          <div class="group p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:border-cyan-500/30 transition-all duration-300 shadow-sm">
            <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
              {feature.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              {feature.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-4">Important Project Flows</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-3xl">
      Three pillars that took the project beyond code: experimental verification, legal compliance and networking expertise.
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {
        flows.map((flow) => (
          <div class="flex flex-col p-8 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-lg transition-all duration-300">
            <span class={`inline-block self-start text-[10px] font-mono font-bold uppercase tracking-wider text-white px-2.5 py-1 rounded-md bg-gradient-to-r ${flow.color} mb-4`}>
              {flow.tag}
            </span>
            <h3 class="text-lg font-bold mb-4 text-gray-900 dark:text-white leading-snug">
              {flow.title}
            </h3>
            <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              {flow.points.map((point) => (
                <li class="flex gap-2">
                  <span class="text-cyan-500 mt-0.5">▸</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-12 grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="relative group">
      <img
        src="/images/catsplash/catsctl_example.jpg"
        alt="catsctl CLI showing status and client list"
        class="rounded-2xl shadow-xl border border-gray-200 dark:border-gray-800 w-full transform transition group-hover:scale-[1.01]"
      />
      <p class="text-center text-xs text-gray-500 mt-3 font-mono uppercase tracking-wider">catsctl · CLI</p>
    </div>
    <div class="relative group">
      <img
        src="/images/catsplash/setup.sh.jpg"
        alt="setup.sh guided installer preparing hostapd, dnsmasq and firewall"
        class="rounded-2xl shadow-xl border border-gray-200 dark:border-gray-800 w-full transform transition group-hover:scale-[1.01]"
      />
      <p class="text-center text-xs text-gray-500 mt-3 font-mono uppercase tracking-wider">setup.sh · Installer</p>
    </div>
  </section>

  <section class="mb-12 text-center p-12 rounded-3xl bg-gradient-to-br from-cyan-600/5 to-blue-500/5 border border-cyan-500/10">
    <h2 class="text-3xl font-bold mb-6">Full Documentation</h2>
    <p class="mb-8 text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
      Installation guides, architecture, performance and networking docs, plus the LOPDP compliance analysis, available on the documentation site and repository.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="https://xeland314.github.io/catsplash-docs/en/"
        target="_blank"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-bold transition-all transform hover:-translate-y-1 shadow-lg shadow-cyan-600/20"
      >
        Read Documentation
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </a>
      <a
        href="https://github.com/xeland314/catsplash"
        target="_blank"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gray-800 hover:bg-gray-900 dark:bg-gray-700 dark:hover:bg-gray-600 text-white font-bold transition-all transform hover:-translate-y-1 shadow-lg"
      >
        View on GitHub
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
      </a>
    </div>
  </section>
</ProjectLayout>
