---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MapMaker } from "../components/tools/map-maker/MapMaker";

const title = "Mapa Personalizado — Marca puntos ilimitados con Leaflet | Mini Apps";
const description = "Crea mapas personalizados con Leaflet: marca cientos de ubicaciones sin el límite de 10 de Google, con íconos y colores diferentes, búsqueda, arrastre y exportación a GeoJSON/CSV.";
const keywords = "mapa personalizado, leaflet, marcadores ilimitados, openstreetmap, geojson, mapa interactivo, google my maps alternativa";
const author = "Christopher Alexander Villamarín Pila";
const url = "https://xeland314.github.io/mapa-personalizado/";
const image = "https://xeland314.github.io/assets/images/logo_v3.png";
---

<BaseLayout
  showHeader={false}
  title={title}
  description={description}
  keywords={keywords}
  author={author}
  url={url}
  image={image}
  canonical={url}
>
  <main class="min-h-screen bg-[#f8fafc] dark:bg-[#060a0f] text-slate-900 dark:text-gray-200">
    <div class="max-w-[1600px] mx-auto py-4 px-4 sm:px-6 flex flex-col gap-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <a href="/mini-apps/" class="text-xs font-bold text-emerald-600 hover:underline inline-flex items-center gap-1">← Mini Apps</a>
            <span class="text-xs font-mono text-slate-500 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 rounded-full">Leaflet + OSM · Lucide</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black tracking-tighter text-slate-900 dark:text-white">
            Mapa <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500">Personalizado</span>
            <span class="ml-2 text-xs font-mono font-bold bg-amber-100 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900 px-2 py-1 rounded-full align-middle">Beta</span>
          </h1>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-3xl">
            Alternativa a Google My Maps sin límite de 10 marcadores. Clic para añadir, arrastra para mover, elige entre <b>22 íconos Lucide</b> y <b>10 colores</b>. Busca direcciones, une puntos con línea y exporta a JSON/GeoJSON/CSV.
          </p>
        </div>
        <div class="flex items-center gap-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400">
          <span class="hidden md:inline">Datos guardados localmente · sin cuenta</span>
        </div>
      </div>

      <div class="flex-1 min-h-0">
        <MapMaker client:only="react" />
      </div>

      <footer class="text-[11px] text-slate-400 text-center py-2">
        Tiles © OpenStreetMap contributors · CARTO · Esri · Búsqueda vía Nominatim (OSM). Tus puntos se guardan en tu navegador (localStorage).
      </footer>
    </div>
  </main>
</BaseLayout>
